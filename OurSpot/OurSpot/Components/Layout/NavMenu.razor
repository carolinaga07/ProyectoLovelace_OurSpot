<head>
    <meta charset="utf-8" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family: 'Poppins', sans-serif;
        }

        ul{
            list-style: none;
        }

        .accordion-menu{
           width: 100%;
           max-height: none !important;
           background: #2D5056;
           border-radius: 0px;
           overflow: visible;
        }

        .accordion-menu li:last-child .dropdown{
            border-bottom: 0;
        }

        .accordion-menu li.active .dropdown{
            color: #fff;

        }

        .accordion-menu li.active .dropdown .bi-chevron-down{
            transform: rotate(180deg);
        }

        .dropdown {
            cursor: pointer;
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
            padding: 15px 20px;
            font-size: 16px;
            border-bottom: 1px solid #B4C8CC;
            color: #FFFFFF;
            position: relative;
            white-space: nowrap;
            transition: background 0.3s ease;
        }

        .dropdown:hover{
            background: #4C6D76;
        }

        .dropdown i.bi-menu-icon {
            position: static !important;
            font-size: 1.2rem;
            margin-right: 12px;
         }

        .dropdown i.bi-chevron-down {
            position: static !important;
            margin-left: auto;
            transition: transform 0.2s ease-in-out;
        } 

        .SubmenuItems{
            display: none;
            background: #2D5056;
        }

        .accordion-menu li.active .SubmenuItems{
            display: block;

        }

        .SubmenuItems a{
            display: block;
            color: #fff;
            font-weight: 600;
            padding: 12px 12px 12px 45px;
            transition : all 0.2s ease-out;
            text-decoration: none;
        }

        .SubmenuItems a:hover{
            background: #5c7185;
            color: #fff;

        }

        .dropdown .bi-chevron-down {
            margin-left: 6px !important;
        }

        .config-btn {
            cursor: pointer;
            color: #FFFFFF;
            padding: 15px 20px;
            border-top: 1px solid #B4C8CC;
            background: #2D5056;
            transition: background 0.3s ease;
            text-decoration: none;
            font-size: 16px;
            width: 100%;
        }

        .config-btn:hover {
            background: #4C6D76;
            color: #FFFFFF;
        }

        .accordion-menu li:first-child .dropdown {
            border-top: 1px solid #2D5056;
            
        }


    </style>
</head>

