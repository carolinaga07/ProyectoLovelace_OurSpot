@page "/Servicios/Decoracion/Eliminar"

<PageTitle>Eliminar Servicio de Decoraci&oacute;n</PageTitle>

<div class="container mt-4">
    <div class="card shadow-lg">
        @* Header *@
        <div class="card-header text-center">
            <h5><strong>Datos del Servicio</strong></h5>
        </div>

        @* Body *@
        <div class="card-body">
            <div class="text-center text-danger">
                <h5><strong>¿Desea eliminar este servicio de decoraci&oacute;n?</strong></h5>
            </div>

            <ul class="list-group list-group-flush mt-4">
                <li class="list-group-item"><strong>id: </strong>@Id</li>
                <li class="list-group-item"><strong>Nombre: </strong>Decoraciones Roman</li>
                <li class="list-group-item"><strong>Descripcion: </strong>	Servicio de decoración floral</li>
                <li class="list-group-item"><strong>Costo: </strong>$1,500.00</li>`
                <li class="list-group-item"><strong>Estado: </strong>Activo</li>
                <li class="list-group-item"><strong>Proveedor: </strong>Luis Roman</li>
            </ul>
        </div>

        @* Footer *@
        <div class="card-footer text-center">
            <a href="/Servicios/Decoracion" class="btn btn-secondary me-2">
                <span class="bi bi-arrow-left"></span> Volver
            </a>
            <a href="/Servicios/Decoracion" class="btn btn-danger">
                <span class="bi bi-trash"></span> Eliminar
            </a>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }
}