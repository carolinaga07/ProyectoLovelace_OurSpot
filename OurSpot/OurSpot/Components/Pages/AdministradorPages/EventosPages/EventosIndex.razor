@page "/eventos"

<PageTitle>Eventos</PageTitle>

<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center mb-4">
            <h5 class="card-title align-content-center mt-2">Eventos</h5>
            <a href="/eventos/create" class="btn btn-primary" style="background-color:#2D5056"> <span class="bi bi-plus-square-dotted mt-3"></span> Nuevo Evento </a>
        </div>

        <div class="card-body">

            @*labels*@
            <div class="row">

                @*Categoria*@
                <div class="col-3">
                    <label class="col-form-label"><strong>Categor&iacute;a</strong></label>
                </div>

                @*Estado*@
                <div class="col-4">
                    <label class="col-form-label"><strong>Estado</strong></label>
                </div>

                @*Busqueda*@
                <div class="col-5">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>
                </div>
            </div>

            @*Inputs y botones*@
            <div class="row align-items-center mb-3">
                @*Categoria*@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="FiltroCategoria">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="Cultural">Cultural</option>
                        <option value="Social">Social</option>
                        <option value="Empresarial">Empresarial</option>
                        <option value="Deportivo">Deportivo</option>
                    </InputSelect>
                </div>

                @*Estado*@
                <div class="col-4">
                    <InputSelect class="form-select" @bind-Value="FiltroEstado">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="Activo">Activo</option>
                        <option value="Cancelado">Cancelado</option>
                        <option value="Realizado">Realizado</option>
                    </InputSelect>
                </div>

                @*Busqueda*@
                <div class="col-5">
                    <div class="input-group">
                        <input class="form-control" @bind="FiltroBusqueda" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search"></button>
                    </div>
                </div>

            </div>

            <table class="table table-hover">
                <thead class="table  table-striped text-black">
                    <tr>
                        <th>Evento</th>
                        <th>Categoria</th>
                        <th>Fecha</th>
                        <th>Lugar</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var evento in listaEventos)
                    {
                        <tr>
                            <td> @evento.Nombre</td>
                            <td> @evento.Categoria</td>
                            <td> @evento.Fecha</td>
                            <td> @evento.Lugar</td>
                            <td> @evento.Tipo</td>
                            <td> @evento.Estado</td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer d-flex justify-content-between align-center mb-4">
        </div>
    </div>
</div>

@code {
    private List<Evento>? listaEventos;

    private string FiltroCategoria { get; set; } = string.Empty;
    private string FiltroEstado { get; set; } = string.Empty;
    private string FiltroBusqueda { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        listaEventos = new List<Evento>
        {
               new Evento(1, "Boda de los Perez", "Social", new DateOnly(2026, 12, 2), "Salon Palma Real", "Privado", "Pendiente"),
               new Evento(2, "Feria Municipal de Artesanos", "Cultural", new DateOnly(2026, 10, 18), "Parque Central", "Publico", "Activo"),
               new Evento(3, "Conferencia Empresarial Santa Barbara", "Empresarial", new DateOnly(2027, 9, 10), "Hotel Barcelo", "Privado", "Pendiente")

        };
    }

    public class Evento
    {
        public int Id { get; set; }
        public string Nombre { get; set; }
        public string Categoria { get; set; }
        public DateOnly Fecha { get; set; }
        public string Lugar { get; set; }
        public string Tipo { get; set; }
        public string Estado { get; set; }

        public Evento(int id, string nombre, string categoria, DateOnly fecha, string lugar, string tipo, string estado)
        {
            Id = id;
            Nombre = nombre;
            Categoria = categoria;
            Fecha = fecha;
            Lugar = lugar;
            Tipo = tipo;
            Estado = estado;
        }
    }
}
