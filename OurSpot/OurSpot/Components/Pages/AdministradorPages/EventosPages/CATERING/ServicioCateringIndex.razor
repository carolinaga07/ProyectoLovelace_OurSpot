@page "/Servicios/Catering"

<style>
    .grid {
        height: 16.5rem;
        overflow-y: auto;
    }

        .grid table {
            width: 100%;
            border-collapse: collapse;
        }

        .grid th, .grid td {
            padding: 8px;
            text-align: left;
        }

        .grid thead {
            position: sticky;
            top: 0;
            background-color: #eee;
        }

        .grid tr:nth-child(even) {
            background: rgba(255,255,255,0.4);
        }

    .text-right {
        text-align: right !important;
    }

    .text-center {
        text-align: center !important;
    }
</style>

<h3>Servicios disponibles: Catering.</h3>

<div class="grid">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title m-0">Lista de Servicios</h5>
            <a href="/Servicios/Crear" class="btn btn-primary">
                <label class="bi bi-plus-square me-1"> Crear</label>
            </a>
        </div>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>id</th>
                <th>Nombre</th>
                <th>Descripcion</th>
                <th class="text-right">Costo</th>
                <th>Estado</th>
                <th>Proveedor</th>
                <th class="text-center">Opciones</th>
            </tr>
        </thead>
        <tbody>
            @if (listaServicios != null)
            {
                @foreach (var s in listaServicios)
                {
                    <tr>
                        <td>@s.Id</td>
                        <td>@s.Nombre</td>
                        <td>@s.Descripcion</td>
                        <td class="text-right">@s.Costo.ToString("C2")</td>
                        <td>@s.Estado</td>
                        <td>@s.Proveedor</td>
                        <td class="text-center">
                            <a href="/Servicios/Editar"
                               class="btn btn-outline-primary bi bi-pencil-square"></a>
                            <a href="/Servicios/Eliminar" class="btn btn-outline-danger bi bi-trash"></a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>


@code {

    private List<Servicio>? listaServicios;

    protected override void OnInitialized()
    {
        listaServicios = new List<Servicio>
        {
            new Servicio(1, "La cocina de Karen", "lorem ipsum lorem ipsum", 1500.00m, "Activo", "Karen Garcia", "Catering"),
            new Servicio(2, "CookingMike", "lorem ipsum lorem ipsum.", 2500.50m, "Activo", "Mike Burgos", "Catering"),
            new Servicio(3, "D'Laura Comidas", "lorem ipsum lorem ipsum", 4000.00m, "Inactivo", "Laura Mejia", "Catering"),
            new Servicio(4, "5 Estrellas Food Service", "lorem ipsum lorem ipsum", 800.00m, "Activo", "5 Estrellas Food Service SRL", "Catering")

};
    }

}