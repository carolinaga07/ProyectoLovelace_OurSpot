@attribute [Authorize(Roles = "Administrador")]
@page "/Servicios/Aniversario"
@rendermode InteractiveServer

@implements IAsyncDisposable

@inject EventosService eventoService
@inject ToastService toastService

<PageTitle>Categoria: Aniversario.</PageTitle>

<style>
    .estado {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 15px;
        font-size: 12px;
    }

    .pendiente {
        background-color: #faf4e3;
        color: #9a8550;
    }

    .activo {
        background-color: #dce9df;
        color: #416849;
    }

    .finalizado {
        background-color: #e0eaf5;
        color: #42678d;
    }

    .cancelado {
        background-color: #f5dddd;
        color: #a34c4c;
    }
</style>

<div class="container-fluid px-3">
    <div class="card shadow-lg">

        @* Encabezado *@
        <div class="card-header d-flex justify-content-between align-items-center mb-4">
            <h5 class="card-title align-content-center mt-2">Categoria: Aniversario.</h5>
        </div>

        <div class="card-body">

            @* Labels *@
            <div class="row">
                <div class="col-3">
                    <label class="col-form-label">
                        <strong>Tipo</strong>
                    </label>
                </div>

                <div class="col-3">
                    <label class="col-form-label">
                        <strong>Estado</strong>
                    </label>
                </div>

                <div class="col-5">
                    <label class="col-form-label">
                        <strong>Búsqueda</strong>
                    </label>
                </div>
            </div>

            @* Filtros *@
            <div class="row align-items-center mb-3">

                @* Tipo *@
                <div class="col-3">
                    <InputSelect class="form-select"
                                 @bind-Value="FiltroTipo">
                        <option value="">Todos los tipos</option>

                        @foreach (var tipo in tiposDisponibles)
                        {
                            <option value="@tipo">@tipo</option>
                        }
                    </InputSelect>
                </div>

                @* Estado *@
                <div class="col-3">
                    <InputSelect class="form-select"
                                 @bind-Value="FiltroEstado">
                        <option value="">Todos los estados</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="Activo">Activo</option>
                        <option value="Finalizado">Finalizado</option>
                        <option value="Cancelado">Cancelado</option>
                    </InputSelect>
                </div>

                @* Búsqueda *@
                <div class="col-5">
                    <div class="input-group">
                        <input class="form-control"
                               @bind="FiltroBusqueda"
                               placeholder="Buscar nombre, lugar o Id" />

                        <button type="button"
                                class="btn btn-outline-primary bi bi-search"
                                title="Buscar"
                                @onclick="Buscar">
                        </button>
                    </div>
                </div>

                @* Restablecer *@
                <div class="col-1">
                    <button type="button"
                            class="btn btn-outline-secondary bi bi-arrow-counterclockwise"
                            title="Restablecer"
                            @onclick="Restablecer">
                    </button>
                </div>
            </div>

            @* Tabla *@
            <div class="table-responsive">
                <QuickGrid Items="listaEventos.AsQueryable()"
                           class="table table-hover text-center mt-3"
                           style="min-width: 950px;">

                    <PropertyColumn Property="e => e.EventoId"
                                    Title="Id"
                                    Sortable="true" />

                    <TemplateColumn Title="Fecha de inicio">
                        <div class="text-nowrap">
                            @context.FechaInicio.ToString("dd/MM/yyyy")
                            @context.HoraInicio.ToString("HH:mm")
                        </div>
                    </TemplateColumn>

                    <TemplateColumn Title="Fecha de cierre">
                        <div class="text-nowrap">
                            @context.FechaCierre.ToString("dd/MM/yyyy")
                            @context.HoraCierre.ToString("HH:mm")
                        </div>
                    </TemplateColumn>

                    <PropertyColumn Property="e => e.Nombre"
                                    Title="Nombre"
                                    Sortable="true" />

                    <PropertyColumn Property="e => e.Lugar"
                                    Title="Lugar"
                                    Sortable="true" />

                    <PropertyColumn Property="e => e.Total"
                                    Title="Total"
                                    Sortable="true" />

                    <TemplateColumn Title="Estado">
                        <span class="estado @(context.Estado?.ToLowerInvariant())">
                            @context.Estado
                        </span>
                    </TemplateColumn>

                </QuickGrid>
            </div>
        </div>

        @* Footer *@
        <div class="card-footer d-flex justify-content-between align-items-center mb-4">
            <label>
                <strong>Cantidad: </strong>@listaEventos.Count
            </label>

            <a href="/Eventos/Recuperar"
               class="btn btn-outline-primary bi bi-trash"
               title="Recuperar">
            </a>
        </div>
    </div>
</div>

@code {
    private List<Evento> listaEventos = new();
    private List<Evento> todosEventos = new();
    private List<string> tiposDisponibles = new();

    private string FiltroTipo { get; set; } = string.Empty;
    private string FiltroEstado { get; set; } = string.Empty;
    private string FiltroBusqueda { get; set; } = string.Empty;

    private bool filtrosAplicados = false;

    private Evento? eventoSeleccionado;
    private bool procesando = false;

    private CancellationTokenSource? cancelacion;
    private Task? tareaActualizacion;

    protected override async Task OnInitializedAsync()
    {
        await CargarEventos();

        cancelacion = new CancellationTokenSource();

        tareaActualizacion = ActualizarEventosAutomaticamente(
            cancelacion.Token);
    }

    private async Task ActualizarEventosAutomaticamente(
        CancellationToken token)
    {
        using var timer = new PeriodicTimer(
            TimeSpan.FromSeconds(5));

        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(async () =>
                {
                    await CargarEventos();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // La página se cerró o el usuario cambió de menú.
        }
    }

    private async Task CargarEventos()
    {
        var eventos = await eventoService.GetList(
            e => e.EventoId > 0 && !e.Eliminado && e.Categoria == "Aniversario");

        todosEventos = eventos
            .OrderByDescending(e => e.EventoId)
            .ToList();

        tiposDisponibles = todosEventos
            .Where(e => !string.IsNullOrWhiteSpace(e.Tipo))
            .Select(e => e.Tipo)
            .Distinct()
            .OrderBy(t => t)
            .ToList();

        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        if (!filtrosAplicados)
        {
            listaEventos = todosEventos.ToList();
            return;
        }

        var busqueda = FiltroBusqueda.Trim();

        listaEventos = todosEventos
            .Where(e =>
                (FiltroTipo == "" ||
                 e.Tipo == FiltroTipo) &&

                (FiltroEstado == "" ||
                 e.Estado == FiltroEstado) &&

                (busqueda == "" ||
                 e.Nombre.Contains(
                     busqueda,
                     StringComparison.OrdinalIgnoreCase) ||
                 e.Lugar.Contains(
                     busqueda,
                     StringComparison.OrdinalIgnoreCase) ||
                 e.EventoId.ToString().Contains(busqueda))
            )
            .ToList();
    }

    private void Buscar()
    {
        filtrosAplicados = true;
        AplicarFiltros();
    }

    private void Restablecer()
    {
        FiltroTipo = string.Empty;
        FiltroEstado = string.Empty;
        FiltroBusqueda = string.Empty;

        filtrosAplicados = false;

        AplicarFiltros();
    }

    private void SeleccionarEvento(Evento evento)
    {
        eventoSeleccionado = evento;
    }

    private async Task Eliminar()
    {
        if (procesando || eventoSeleccionado == null)
            return;

        procesando = true;

        try
        {
            bool eliminado = await eventoService.Eliminar(
                eventoSeleccionado.EventoId);

            if (eliminado)
            {
                toastService.ShowSuccess(
                    "Evento Eliminado Exitosamente");

                eventoSeleccionado = null;

                await CargarEventos();
            }
            else
            {
                toastService.ShowError(
                    "Error al Eliminar el Evento");
            }
        }
        catch (Exception)
        {
            toastService.ShowError(
                "Ocurrió un error al eliminar el evento");
        }
        finally
        {
            procesando = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (cancelacion is not null)
        {
            await cancelacion.CancelAsync();

            if (tareaActualizacion is not null)
            {
                try
                {
                    await tareaActualizacion;
                }
                catch (OperationCanceledException)
                {
                }
            }

            cancelacion.Dispose();
        }
    }
}