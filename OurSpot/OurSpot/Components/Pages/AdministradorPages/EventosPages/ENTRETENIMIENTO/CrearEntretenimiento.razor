@page "/Servicios/Entretenimiento/Crear"

<PageTitle>Crear Servicio de Entretenimiento</PageTitle>

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header text-center">
            <h3 class="card-title">Agregar Servicio de Entretenimiento</h3>
        </div>

        <div class="card-body">
            @* id *@
            <div class="mb-3">
                <label class="form-label"><strong>id</strong></label>
                <input type="number" class="form-control" value="1" readonly />
            </div>

            @* Nombre *@
            <div class="mb-3">
                <label class="form-label"><strong>Nombre</strong></label>
                <input type="text" class="form-control" placeholder="Ej. Payaso Bobby" />
            </div>

            @* Descripcion *@
            <div class="mb-3">
                <label class="form-label"><strong>Descripcion</strong></label>
                <textarea class="form-control" rows="3" placeholder="Descripción detallada del servicio."></textarea>
            </div>

            @* Costo *@
            <div class="mb-3">
                <label class="form-label"><strong>Costo</strong></label>
                <input type="number" step="0.01" class="form-control" placeholder="0.00" />
            </div>

            @* Estado *@
            <div class="mb-3">
                <label class="form-label"><strong>Estado</strong></label>
                <input type="text" class="form-control" value="Activo" readonly />
            </div>

            @* Proveedor *@
            <div class="mb-3">
                <label class="form-label"><strong>Proveedor</strong></label>
                <input type="text" class="form-control" placeholder="Ej. Risas Compartidas SRL" />
            </div>

            @*Tipo de Servicio*@
            <div class="mb-3">
                <label class="form-label"><strong>Estado</strong></label>
                <select class="form-select">
                    <option selected disabled>Seleccione un estado</option>
                    <option value="Refrigeraci&oacute;n">Refrigeraci&oacute;n</option>
                    <option value="Decoraci&oacute;n">Decoraci&oacute;n</option>
                    <option value="Catering">Catering</option>
                    <option value="Entretenimiento">Entretenimiento</option>
                    <option value="Seguridad">Seguridad</option>
                    <option value="Fotograf&iacute;a">Entretenimiento</option>

                </select>
            </div>
        </div>

        @* Footer con botones de navegación *@
        <div class="card-footer text-center">
            <a href="/Servicios/Entretenimiento" class="btn btn-secondary me-2">
                <span class="bi bi-arrow-left"></span> Volver
            </a>
            <a href="/Servicios/Entretenimiento" class="btn btn-primary">
                <span class="bi bi-floppy"></span> Guardar
            </a>
        </div>
    </div>
</div>

@code{
    Servicio servicio = new Servicio();
}