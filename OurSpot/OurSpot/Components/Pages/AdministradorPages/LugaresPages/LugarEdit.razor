@page "/lugares/edit"
@rendermode InteractiveServer

<PageTitle>Editar lugar</PageTitle>

<div class="form-page">

    <div class="form-card">

        <div class="form-header">
            <h2>Editar Lugar</h2>
        </div>

        <div class="form-body">

            <div class="campo">
                <label>Id</label>

                <input type="text"
                       class="form-control"
                       value="1"
                       readonly />
            </div>

            <div class="campo">
                <label>Ubicación</label>

                <input type="text"
                       class="form-control"
                       value="Centro Cultural La Nave" />
            </div>

            <div class="campo">
                <label>Categoría</label>

                <select class="form-select">
                    <option selected>Centro cultural</option>
                    <option>Salón de eventos</option>
                    <option>Auditorio</option>
                    <option>Espacio abierto</option>
                    <option>Restaurante</option>
                    <option>Otro</option>
                </select>
            </div>

            <div class="campo">
                <label>Capacidad</label>

                <input type="number"
                       class="form-control"
                       value="150" />
            </div>

            <div class="campo">
                <label>Descripción</label>

                <textarea class="form-control descripcion">Espacio destinado a talleres, exposiciones, actividades culturales y realización de eventos.</textarea>
            </div>

            <div class="campo">
                <label>Estado</label>

                <select class="form-select">
                    <option selected>Disponible</option>
                    <option>No disponible</option>
                </select>
            </div>

        </div>

        <div class="form-footer">

            <a href="/lugares"
               class="btn-cancelar">

                <i class="bi bi-arrow-left"></i>
                Cancelar
            </a>

            <button type="button"
                    class="btn-guardar">

                <i class="bi bi-floppy"></i>
                Guardar
            </button>

        </div>

    </div>

</div>
