
@page "/Lugares/Edit/{Id:int}"
@rendermode InteractiveServer

@inject LugaresService lugaresService
@inject ToastService toastService
@inject NavigationManager navigationManager

<PageTitle>Modificar Lugar</PageTitle>

<EditForm Model="Lugar" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container mt-4">
        <div class="card shadow-lg">

            <div class="card-header text-center">
                <h3 class="card-title">Editar Lugar</h3>
            </div>

            <div class="card-body">

                @* Ubicación *@
                <div class="mb-3">
                    <label class="form-label"><strong>Ubicación</strong></label>
                    <InputText class="form-control" @bind-Value="Lugar.Ubicacion" placeholder="Ej. Centro Cultural La Nave" />
                    <ValidationMessage For="@(() => Lugar.Ubicacion)" />
                </div>

                 @* Categoría *@
                <div class="mb-3">
                    <label class="form-label"><strong>Categoría</strong></label>
                    <InputSelect class="form-select" @bind-Value="Lugar.Categoria">
                        <option value="" disabled>Seleccione una categoría</option>
                        <option value="Aniversario">Aniversario</option>
                        <option value="Boda">Boda</option>
                        <option value="Cumpleaños">Cumpleaños</option>
                        <option value="Celebración Religiosa">Celebración Religiosa</option>
                        <option value="Graduación">Graduación</option>
                        <option value="Funeral">Funeral</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => Lugar.Categoria)" />
                </div>

                @* Capacidad *@
                <div class="mb-3">
                    <label class="form-label"><strong>Capacidad</strong></label>
                    <InputNumber class="form-control" @bind-Value="Lugar.Capacidad" placeholder="Ej. 150" />
                    <ValidationMessage For="@(() => Lugar.Capacidad)" />
                </div>

                @* Estado *@
                <div class="mb-3">
                    <label class="form-label"><strong>Estado</strong></label>
                    <input type="text" class="form-control" @bind-value="Lugar.Estado" readonly />
                </div>

            </div>
      
            @* Footer *@
            <div class="card-footer text-center mb-2">
                <a href="/Lugares/Index" class="btn btn-secondary"><span class="bi bi-arrow-left"></span> Volver</a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Modificar</button>
                <button type="button" class="btn btn-danger bi bi-trash" data-bs-toggle="modal" data-bs-target="#modalEliminar"> Eliminar</button>
            </div>

        </div>
    </div>
</EditForm>

@* Modal de Eliminación *@
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalCerrar" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="modalCerrar">Confirmación de eliminación</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <p>¿Desea eliminar el lugar @Lugar.Ubicacion?</p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-danger" @onclick="Eliminar">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }
    public Lugares Lugar = new Lugares();

    protected override async Task OnParametersSetAsync()
    {
        var LugarEncontrado = await lugaresService.Buscar(Id);

        if (LugarEncontrado != null)
        {
            Lugar = LugarEncontrado;
        }
        else
        {
            toastService.ShowError("No se encontró el lugar");
            navigationManager.NavigateTo("/Lugares/Index");
        }
    }

    private async Task Modificar()
    {
        bool modificado = await lugaresService.Guardar(Lugar);

        if (modificado)
        {
            toastService.ShowSuccess("Lugar Modificado Exitosamente");
            navigationManager.NavigateTo("/Lugares/Index");
        }
        else
        {
            toastService.ShowError("Error al Modificar el Lugar");
        }
    }

    private async Task Eliminar()
    {
        bool eliminado = await lugaresService.Eliminar(Lugar.Id);

        if (eliminado)
        {
            toastService.ShowSuccess("Lugar Eliminado Exitosamente");
            navigationManager.NavigateTo("/Lugares/Index");
        }
        else
        {
            toastService.ShowError("Error al Eliminar el Lugar");
        }
    }
}
