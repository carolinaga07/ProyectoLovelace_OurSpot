@attribute [Authorize(Roles = "Administrador")]
@page "/Lugares/Index"
@rendermode InteractiveServer

@inject LugaresService lugaresService
@inject ToastService toastService
@inject NavigationManager navigationManager

<PageTitle>Lugares</PageTitle>

<style>
    .estado {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 15px;
        font-size: 12px;
    }

    .disponible {
        background-color: #dce9df;
        color: #416849;
    }

    .no-disponible {
        background-color: #faf4e3;
        color: #9a8550;
    }
</style>

<div class="container">
    <div class="card shadow-lg">

        @* Encabezado *@
        <div class="card-header d-flex justify-content-between align-items-center mb-4">
            <h5 class="card-title align-content-center mt-2">Lugares</h5>
            <a href="/lugares/create" class="btn btn-primary" style="background-color:#2D5056">
                <span class="bi bi-plus-square-dotted"></span> Nuevo Lugar
            </a>
        </div>

        <div class="card-body">

            @* Labels de filtros *@
            <div class="row">

                @* Estado *@
                <div class="col-3">
                    <label class="col-form-label"><strong>Estado</strong></label>
                </div>

                @* Búsqueda *@
                <div class="col-5">
                    <label class="col-form-label"><strong>Búsqueda</strong></label>
                </div>

            </div>

            @* Filtros *@
            <div class="row align-items-center mb-3">

                @* Estado *@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="FiltroEstado">
                        <option value="">Todos los estados</option>
                        <option value="Disponible">Disponible</option>
                        <option value="No Disponible">No Disponible</option>
                    </InputSelect>
                </div>

                @* Búsqueda *@
                <div class="col-5">
                    <div class="input-group">
                        <input class="form-control" @bind="FiltroBusqueda" placeholder="Buscar nombre, ubicación o Id" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar" title="Buscar"></button>
                    </div>
                </div>

                @* Restablecer *@
                <div class="col-1">
                    <button type="button" class="btn btn-outline-secondary bi bi-arrow-counterclockwise" @onclick="Restablecer"></button>
                </div>

            </div>

            @* Tabla de Lugares *@
            <div class="grid">
                <QuickGrid Items="@itemsQueryable" Class="table table-hover">
                    <PropertyColumn Property="l => l.Id" Title="Id" Sortable="true" />

                    @* Nombre - Columna agregada *@
                    <PropertyColumn Property="l => l.Nombre" Title="Nombre" Sortable="true" />

                    <PropertyColumn Property="l => l.Ubicacion" Title="Ubicación" Sortable="true" />
                    <PropertyColumn Property="l => l.Capacidad" Title="Capacidad" Sortable="true" />

                    <TemplateColumn Title="Estado" Sortable="true" SortBy="estadoSort">
                        <span class="estado @(context.Estado == "Disponible" ? "disponible" : "no-disponible")">
                            @context.Estado
                        </span>
                    </TemplateColumn>

                    <TemplateColumn Title="Opciones">
                        <a href="@($"/Lugares/Edit/{context.Id}")"
                           class="btn btn-outline-primary bi bi-pencil-square"
                           title="Modificar"></a>

                        <button type="button"
                                class="btn btn-outline-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#modalEliminar" @onclick="() => Lugar = context">
                            <span class="bi bi-x-lg"></span>
                        </button>
                    </TemplateColumn>
                </QuickGrid>
            </div>

        </div>

        @* Footer *@
        <div class="card-footer d-flex justify-content-between align-items-center mb-4">
            <label><strong>Cantidad: </strong>@itemsQueryable.Count()</label>
            <a href="/Lugares/Recuperar" class="btn btn-outline-primary bi bi-trash" title="Recuperar"></a>
        </div>

    </div>
</div>


@* Modal de Eliminación *@
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalCerrar" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="modalCerrar"> Confirmación de eliminación </h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"> </button>
            </div>

            <div class="modal-body">
                @if (Lugar != null)
                {
                    <p>¿Desea eliminar el lugar @Lugar.Nombre?</p>
                }
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"> Cerrar </button>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="Eliminar"> Eliminar</button>
            </div>
        </div>
    </div>
</div>

@code {
    public string FiltroEstado { get; set; } = string.Empty;
    public string FiltroBusqueda { get; set; } = string.Empty;

    public IQueryable<Lugares> itemsQueryable =
        Enumerable.Empty<Lugares>().AsQueryable();

    public Lugares Lugar { get; set; } = new();

    private GridSort<Lugares> estadoSort =
        GridSort<Lugares>.ByAscending(l => l.Estado);

    protected override async Task OnInitializedAsync()
    {
        var items = await lugaresService.GetList(l => l.Eliminado == false);
        itemsQueryable = items.AsQueryable();
    }

    private async Task Buscar()
    {
        if (FiltroBusqueda.Trim() == "" && FiltroEstado == "")
        {
            var items = await lugaresService.GetList(l => l.Eliminado == false);
            itemsQueryable = items.AsQueryable();
        }
        else
        {
            var busqueda = FiltroBusqueda.Trim().ToLower();

            var items = await lugaresService.GetList(l =>
                l.Eliminado == false &&
                (FiltroEstado == "" || l.Estado == FiltroEstado) &&
                (busqueda == "" ||
                    (l.Nombre != null && l.Nombre.ToLower().Contains(busqueda)) ||
                    (l.Ubicacion != null && l.Ubicacion.ToLower().Contains(busqueda)) ||
                    l.Id.ToString().Contains(busqueda)
                )
            );

            itemsQueryable = items.AsQueryable();
        }
    }

    private async Task Restablecer()
    {
        itemsQueryable = (await lugaresService.GetList(l => !l.Eliminado)).AsQueryable();
        FiltroEstado = string.Empty;
        FiltroBusqueda = string.Empty;
    }

    private async Task Eliminar()
    {
        bool eliminado = await lugaresService.Eliminar(Lugar.Id);

        if (eliminado)
        {
            toastService.ShowSuccess("Lugar Eliminado Exitosamente");
            navigationManager.NavigateTo("/Lugares/Index");
        }
        else
        {
            toastService.ShowError("Error al Eliminar el Lugar");
        }
    }
}
