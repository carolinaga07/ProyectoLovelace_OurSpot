
@page "/lugares"
@rendermode InteractiveServer

<PageTitle>Lugares</PageTitle>

<style>
    .grid {
        max-height: 24rem;
        overflow-y: auto;
    }

    .grid table {
        width: 100%;
        border-collapse: collapse;
    }

    .grid th, .grid td {
        padding: 12px;
        text-align: left;
        vertical-align: middle;
    }

    .grid thead {
        position: sticky;
        top: 0;
        background-color: #eee;
        z-index: 1;
    }

    .grid tr:nth-child(even) {
        background: rgba(255,255,255,0.4);
    }

    .text-center {
        text-align: center !important;
    }

    .estado {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 15px;
        font-size: 12px;
    }

    .disponible {
        background-color: #dce9df;
        color: #416849;
    }

    .no-disponible {
        background-color: #eadede;
        color: #8a4d4d;
    }
</style>

<div class="container">

    <div class="card shadow-lg">

        @* Encabezado *@
        <div class="card-header d-flex justify-content-between align-items-center mb-4">

            <h5 class="card-title align-content-center mt-2">
                Lugares
            </h5>

            <a href="/lugares/create"
               class="btn btn-primary"
               style="background-color:#2D5056">

                <span class="bi bi-plus-square-dotted"></span>
                Nuevo Lugar
            </a>

        </div>

        <div class="card-body">

            @* Labels de filtros *@
            <div class="row">

                <div class="col-3">
                    <label class="col-form-label">
                        <strong>Categoría</strong>
                    </label>
                </div>

                <div class="col-4">
                    <label class="col-form-label">
                        <strong>Estado</strong>
                    </label>
                </div>

                <div class="col-5">
                    <label class="col-form-label">
                        <strong>Búsqueda</strong>
                    </label>
                </div>

            </div>

            @* Filtros *@
            <div class="row align-items-center mb-3">

                @* Categoría *@
                <div class="col-3">

                    <select class="form-select"
                            @bind="FiltroCategoria">

                        <option value="">
                            Todas las categorías
                        </option>

                        <option value="Seguridad">Seguridad</option>
                        <option value="Alimentos">Alimentos</option>
                        <option value="Accesorios">Accesorios</option>
                        <option value="Objetos de uso único">Objetos de uso único</option>
                        <option value="Refrigerado">Refrigerado</option>
                        <option value="Entretenimiento">Entretenimiento</option>
                        <option value="Renta">Renta</option>
                        <option value="Decoraciones">Decoraciones</option>
                        <option value="Otros">Otros</option>

                    </select>

                </div>

                @* Estado *@
                <div class="col-4">

                    <select class="form-select"
                            @bind="FiltroEstado">

                        <option value="">
                            Todos los estados
                        </option>

                        <option value="Disponible">
                            Disponible
                        </option>

                        <option value="No disponible">
                            No disponible
                        </option>

                    </select>

                </div>

                @* Búsqueda *@
                <div class="col-5">

                    <div class="input-group">

                        <input class="form-control"
                               @bind="FiltroBusqueda"
                               @bind:event="oninput"
                               placeholder="Buscar ubicación o Id" />

                        <button type="button"
                                class="btn btn-outline-primary bi bi-search"
                                title="Buscar">
                        </button>

                    </div>

                </div>

            </div>

            @* Tabla de lugares *@
            <div class="grid">

                <table class="table table-hover">

                    <thead class="table-light text-black">

                        <tr>
                            <th>Id</th>
                            <th>Ubicación</th>
                            <th>Categoría</th>
                            <th>Capacidad</th>
                            <th>Estado</th>
                            <th class="text-center">Opciones</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var lugar in LugaresFiltrados)
                        {
                            <tr>

                                <td>@lugar.Id</td>

                                <td>@lugar.Ubicacion</td>

                                <td>@lugar.Categoria</td>

                                <td>@lugar.Capacidad</td>

                                <td>
                                    <span class="estado @(lugar.Estado == "Disponible" ? "disponible" : "no-disponible")">
                                        @lugar.Estado
                                    </span>
                                </td>

                                <td class="text-center">

                                    <a href="@($"/lugares/edit/{lugar.Id}")"
                                       class="btn btn-outline-primary bi bi-pencil-square"
                                       title="Editar">
                                    </a>

                                    <a href="@($"/lugares/eliminar/{lugar.Id}")"
                                       class="btn btn-outline-danger bi bi-trash"
                                       title="Eliminar">
                                    </a>

                                </td>

                            </tr>
                        }

                        @if (!LugaresFiltrados.Any())
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted py-4">

                                    No se encontraron lugares con los filtros seleccionados.

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

        <div class="card-footer"></div>

    </div>

</div>

@code {

    // Filtros
    private string FiltroCategoria { get; set; } = string.Empty;
    private string FiltroEstado { get; set; } = string.Empty;
    private string FiltroBusqueda { get; set; } = string.Empty;

    // Datos de ejemplo
    private List<Lugar> listaLugares = new()
    {
        new Lugar
        {
            Id = 1,
            Ubicacion = "Centro Cultural La Nave",
            Categoria = "Entretenimiento",
            Capacidad = 150,
            Estado = "Disponible"
        },

        new Lugar
        {
            Id = 2,
            Ubicacion = "Salón Las Caobas",
            Categoria = "Renta",
            Capacidad = 250,
            Estado = "Disponible"
        },

        new Lugar
        {
            Id = 3,
            Ubicacion = "Auditorio UCNE",
            Categoria = "Entretenimiento",
            Capacidad = 300,
            Estado = "No disponible"
        }
    };

    // Filtrado por categoría, estado y búsqueda
    private IEnumerable<Lugar> LugaresFiltrados =>
        listaLugares.Where(lugar =>

            (string.IsNullOrEmpty(FiltroCategoria) ||
             lugar.Categoria == FiltroCategoria)

            &&

            (string.IsNullOrEmpty(FiltroEstado) ||
             lugar.Estado == FiltroEstado)

            &&

            (string.IsNullOrWhiteSpace(FiltroBusqueda) ||
             lugar.Ubicacion.Contains(
                 FiltroBusqueda,
                 StringComparison.OrdinalIgnoreCase
             ) ||
             lugar.Id.ToString().Contains(FiltroBusqueda.Trim()))

        );

    // Modelo de ejemplo
    private class Lugar
    {
        public int Id { get; set; }
        public string Ubicacion { get; set; } = "";
        public string Categoria { get; set; } = "";
        public int Capacidad { get; set; }
        public string Estado { get; set; } = "";
    }
}
