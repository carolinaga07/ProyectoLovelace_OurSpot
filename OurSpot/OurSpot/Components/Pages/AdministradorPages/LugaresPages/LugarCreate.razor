@page "/Lugares/Create"
@rendermode InteractiveServer

@inject LugaresService lugaresService
@inject ToastService toastService
@inject NavigationManager navigationManager

<PageTitle>Crear Lugar</PageTitle>

<EditForm Model="Lugar" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div class="container mt-4">
        <div class="card shadow-lg">

            <div class="card-header">
                <h4 class="card-title mt-2">
                    <a href="/Lugares/Index"><i class="bi bi-arrow-left-short fs-1 align-middle" style="color: #2D5056"></i></a> Nuevo Lugar
                </h4>
            </div>
  
            <div class="card-body">

                @* Ubicación *@
                <div class="mb-3">
                    <label class="form-label"><strong>Ubicación</strong></label>
                    <InputText class="form-control" @bind-Value="Lugar.Ubicacion" placeholder="Ej. Centro Cultural La Nave" />
                    <ValidationMessage For="@(() => Lugar.Ubicacion)" />
                </div>

               @* Capacidad *@
                <div class="mb-3">
                    <label class="form-label"><strong>Capacidad</strong></label>
                    <InputNumber class="form-control" @bind-Value="Lugar.Capacidad" placeholder="Ej. 150" />
                    <ValidationMessage For="@(() => Lugar.Capacidad)" />
                </div>

                @* Estado *@
                <div class="mb-3">
                    <label class="form-label"><strong>Estado</strong></label>
                    <input type="text" class="form-control" @bind-value="Lugar.Estado" readonly />
                </div>
            </div>
          
            @* Footer *@
            <div class="card-footer text-center">
                <button type="submit" class="btn btn-primary" style="background-color:#2D5056"> <span class="bi bi-floppy"></span> Guardar </button>
            </div>
  
        </div>
    </div>
</EditForm>

@code {
    public Lugares Lugar = new Lugares();

    private async Task Guardar()
    {
        Lugar.Estado = "Disponible";

        bool guardado = await lugaresService.Guardar(Lugar);

        if (guardado)
        {
            toastService.ShowSuccess("Lugar Guardado Exitosamente");
            navigationManager.NavigateTo("/Lugares/Index");
        }
        else
        {
            if (await lugaresService.Existe(Lugar.Id))
            {
                toastService.ShowError("Este lugar ya fue registrado.");
                return;
            }
            toastService.ShowError("Error al Guardar el Lugar");
        }
    }
}
