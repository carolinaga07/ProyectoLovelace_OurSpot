
@page "/lugares/create"
@rendermode InteractiveServer

<PageTitle>Crear Lugar</PageTitle>

<div class="container mt-4">

    <div class="card shadow-lg">

        <div class="card-header text-center">
            <h3 class="card-title">Agregar Lugar</h3>
        </div>

        <div class="card-body">

            @* Id *@
            <div class="mb-3">
                <label class="form-label">
                    <strong>Id</strong>
                </label>

                <input type="number"
                       class="form-control"
                       value="4"
                       readonly />
            </div>

            @* Ubicación *@
            <div class="mb-3">
                <label class="form-label">
                    <strong>Ubicación</strong>
                </label>

                <input type="text"
                       class="form-control"
                       placeholder="Ej. Centro Cultural La Nave" />
            </div>

            @* Categoría *@
            <div class="mb-3">
                <label class="form-label">
                    <strong>Categoría</strong>
                </label>

                <select class="form-select">
                    <option value="" selected disabled>
                        Seleccione una categoría
                    </option>

                    <option value="Seguridad">Seguridad</option>
                    <option value="Alimentos">Alimentos</option>
                    <option value="Accesorios">Accesorios</option>
                    <option value="Objetos de uso único">Objetos de uso único</option>
                    <option value="Refrigerado">Refrigerado</option>
                    <option value="Entretenimiento">Entretenimiento</option>
                    <option value="Renta">Renta</option>
                    <option value="Decoraciones">Decoraciones</option>
                    <option value="Otros">Otros</option>
                </select>
            </div>

            @* Capacidad *@
            <div class="mb-3">
                <label class="form-label">
                    <strong>Capacidad</strong>
                </label>

                <input type="number"
                       min="1"
                       class="form-control"
                       placeholder="Ej. 150" />
            </div>

            @* Estado *@
            <div class="mb-3">
                <label class="form-label">
                    <strong>Estado</strong>
                </label>

                <select class="form-select">
                    <option value="" selected disabled>
                        Seleccione un estado
                    </option>

                    <option value="Disponible">Disponible</option>
                    <option value="No disponible">No disponible</option>
                </select>
            </div>

        </div>

        @* Footer *@
        <div class="card-footer text-center">

            <a href="/lugares"
               class="btn btn-secondary me-2">

                <span class="bi bi-arrow-left"></span>
                Volver
            </a>

            <a href="/lugares"
               class="btn btn-primary">

                <span class="bi bi-floppy"></span>
                Guardar
            </a>

        </div>

    </div>

</div>
