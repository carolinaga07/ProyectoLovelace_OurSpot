@page "/personal/eliminar/{Id:int}"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using OurSpot.Services

@attribute [Authorize(Roles = "Administrador")]

@inject PersonalService personalService
@inject RegistroPersonalService registroPersonalService
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Eliminar Personal</PageTitle>

@if (personal == null)
{
    <div class="container mt-4">

        <div class="alert alert-warning text-center">
            No se encontró el personal solicitado.
        </div>

        <a href="/personal" class="btn btn-secondary">
            Volver
        </a>

    </div>
}
else
{
    <div class="container mt-4">

        <div class="card shadow-lg">

            <div class="card-header text-center">
                <h5>
                    <strong>Datos del Personal</strong>
                </h5>
            </div>

            <div class="card-body">

                <div class="text-center text-danger">
                    <h5>
                        <strong>
                            ¿Desea eliminar este integrante del personal?
                        </strong>
                    </h5>
                </div>

                @if (!string.IsNullOrEmpty(Mensaje))
                {
                    <div class="alert alert-danger mt-3">
                        @Mensaje
                    </div>
                }

                @if (personal.Rol == "Administrador")
                {
                    <div class="alert alert-warning mt-3">
                        No está permitido eliminar registros de administradores.
                    </div>
                }

                <ul class="list-group list-group-flush mt-4">

                    <li class="list-group-item">
                        <strong>Id:</strong> @personal.Id
                    </li>

                    <li class="list-group-item">
                        <strong>Nombre:</strong> @personal.Nombre
                    </li>

                    <li class="list-group-item">
                        <strong>Correo:</strong> @personal.Correo
                    </li>

                    <li class="list-group-item">
                        <strong>Cargo:</strong> @personal.Cargo
                    </li>

                    <li class="list-group-item">
                        <strong>Rol:</strong> @personal.Rol
                    </li>

                    <li class="list-group-item">
                        <strong>Estado:</strong> @personal.Estado
                    </li>

                    <li class="list-group-item">
                        <strong>Cuenta de usuario:</strong>

                        @(string.IsNullOrEmpty(personal.ApplicationUserId)
                            ? "Sin cuenta"
                            : "Con cuenta")
                    </li>

                </ul>

            </div>

            <div class="card-footer text-center">

                <a href="/personal"
                   class="btn btn-secondary me-2">

                    <span class="bi bi-arrow-left"></span>
                    Volver

                </a>

                @if (personal.Rol != "Administrador")
                {
                    <button type="button"
                            class="btn btn-danger"
                            @onclick="ConfirmarEliminar">

                        <span class="bi bi-trash"></span>
                        Eliminar

                    </button>
                }

            </div>

        </div>

    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Personal? personal;

    private string? Mensaje;

    protected override async Task OnInitializedAsync()
    {
        personal = await personalService.Buscar(Id);
    }

    private async Task ConfirmarEliminar()
    {
        Mensaje = null;

        if (personal == null)
            return;

        try
        {
            var resultado = await registroPersonalService.Eliminar(Id);

            if (resultado.Succeeded)
            {
                toastService.ShowSuccess(
                    "Personal eliminado correctamente.");

                navigationManager.NavigateTo("/personal");
            }
            else
            {
                Mensaje = string.Join("; ",
                    resultado.Errors.Select(e => e.Description));
            }
        }
        catch (Exception)
        {
            Mensaje = "No se pudo eliminar el personal.";
        }
    }
}
