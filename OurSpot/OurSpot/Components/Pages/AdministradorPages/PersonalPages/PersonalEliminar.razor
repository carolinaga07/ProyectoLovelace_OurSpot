@page "/personal/eliminar/{Id:int}"

@using Microsoft.AspNetCore.Authorization
@using OurSpot.Services

@attribute [Authorize(Roles = "Administrador")]

@inject PersonalService personalService
@inject RegistroPersonalService registroPersonalService
@inject NavigationManager navigationManager

<PageTitle>Eliminar Personal</PageTitle>

@if (personal == null)
{
    <div class="container mt-4">
        <div class="alert alert-warning text-center">
            No se encontró el personal solicitado.
        </div>

        <a href="/personal" class="btn btn-secondary">
            Volver
        </a>
    </div>
}
else
{
    <div class="container mt-4">

        <div class="card shadow-lg">

            <div class="card-header text-center">
                <h5>
                    <strong>Datos del Personal</strong>
                </h5>
            </div>

            <div class="card-body">

                <div class="text-center text-danger">
                    <h5>
                        <strong>
                            ¿Desea eliminar este integrante del personal?
                        </strong>
                    </h5>
                </div>

                @if (!string.IsNullOrEmpty(Mensaje))
                {
                    <div class="alert alert-danger mt-3">
                        @Mensaje
                    </div>
                }

                <ul class="list-group list-group-flush mt-4">

                    <li class="list-group-item">
                        <strong>Id:</strong> @personal.Id
                    </li>

                    <li class="list-group-item">
                        <strong>Nombre:</strong> @personal.Nombre
                    </li>

                    <li class="list-group-item">
                        <strong>Correo:</strong> @personal.Correo
                    </li>

                    <li class="list-group-item">
                        <strong>Cargo:</strong> @personal.Cargo
                    </li>

                    <li class="list-group-item">
                        <strong>Rol:</strong> @personal.Rol
                    </li>

                    <li class="list-group-item">
                        <strong>Estado:</strong> @personal.Estado
                    </li>

                </ul>

            </div>

            <div class="card-footer text-center">

                <form method="post"
                      @formname="eliminar-personal"
                      @onsubmit="ConfirmarEliminar"
                      data-enhance="false">

                    <AntiforgeryToken />

                    <a href="/personal"
                       class="btn btn-secondary me-2">

                        <span class="bi bi-arrow-left"></span>
                        Volver

                    </a>

                    <button type="submit"
                            class="btn btn-danger">

                        <span class="bi bi-trash"></span>
                        Eliminar

                    </button>

                </form>

            </div>

        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Personal? personal;
    private string? Mensaje;

    protected override async Task OnInitializedAsync()
    {
        personal = await personalService.Buscar(Id);
    }

    private async Task ConfirmarEliminar()
    {
        Mensaje = null;

        try
        {
            var resultado =
                await registroPersonalService.Eliminar(Id);

            if (resultado.Succeeded)
            {
                navigationManager.NavigateTo(
                    "/personal",
                    forceLoad: true);
            }
            else
            {
                Mensaje = string.Join("; ",
                    resultado.Errors.Select(e => e.Description));
            }
        }
        catch (Exception)
        {
            Mensaje = "No se pudo eliminar el personal.";
        }
    }
}
