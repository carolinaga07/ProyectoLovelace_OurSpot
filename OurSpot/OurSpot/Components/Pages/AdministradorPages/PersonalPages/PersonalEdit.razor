@attribute [Authorize(Roles = "Administrador")]
@page "/personal/edit/{PersonalId:int}"
@rendermode InteractiveServer
@inject PersonalService personalService
@inject ToastService toastService
@inject NavigationManager navigationManager

<PageTitle>Editar Personal</PageTitle>

@if (personal == null)
{
    <p class="text-center">Cargando...</p>
}
else
{
    <EditForm Model="personal" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />

        <div class="container">
            <div class="card shadow-lg">
                <div class="card-header text-center">
                    <h5 class="card-title">Editar Personal</h5>
                </div>

                <div class="card-body">

                    <div class="mb-3">
                        <label class="form-label"><strong>Nombre</strong></label>
                        <InputText class="form-control" @bind-Value="personal.Nombre"></InputText>
                        <ValidationMessage For="(() => personal.Nombre)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><strong>Correo</strong></label>
                        <InputText class="form-control" @bind-Value="personal.Correo"></InputText>
                        <ValidationMessage For="(() => personal.Correo)" />
                    </div>

                    @* Usuario *@
                    <div class="mb-3">
                        <label class="form-label"><strong>Usuario</strong></label>
                        <InputText class="form-control" @bind-Value="personal.Usuario"></InputText>
                        <ValidationMessage For="(() => personal.Usuario)" />
                    </div>

                    @* Contraseña *@
                    <div class="mb-3">
                        <label class="form-label"><strong>Contraseña</strong></label>
                        <div class="input-group">
                            <InputText type="@tipoPassword" class="form-control" @bind-Value="personal.Contrasena"></InputText>
                            <button type="button" class="btn btn-outline-secondary" @onclick="AlternarMostrarContrasena">
                                <span class="bi @iconoPassword"></span>
                            </button>
                        </div>
                        <ValidationMessage For="(() => personal.Contrasena)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><strong>Cargo</strong></label>
                        <InputSelect class="form-select" @bind-Value="personal.Cargo">
                            <option value="Administrador">Administrador</option>
                            <option value="Empleado">Empleado</option>
                        </InputSelect>
                        <ValidationMessage For="(() => personal.Cargo)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><strong>Estado</strong></label>
                        <InputSelect class="form-select" @bind-Value="personal.Estado">
                            <option value="Activo">Activo</option>
                            <option value="Inactivo">Inactivo</option>
                        </InputSelect>
                    </div>
                </div>

                <div class="card-footer text-center mt-2">
                    <a href="/personal" class="btn btn-secondary"><span class="bi bi-arrow-left"></span> Volver</a>
                    <button type="submit" class="btn btn-primary bi bi-floppy"> Guardar</button>
                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modalEliminar"> <span class="bi bi-x-lg"></span> Eliminar </button>
                </div>
            </div>
        </div>
    </EditForm>

    @* Modal de Eliminación *@
    <div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalCerrar" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="modalCerrar"> Confirmación de eliminación </h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"> </button>
                </div>

                <div class="modal-body">
                    @if (personal != null)
                    {
                        <p>¿Eliminar a @personal.Nombre?</p>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"> Cerrar </button>
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="Eliminar"> Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int PersonalId { get; set; }

    private Personal? personal;
    private bool mostrarContrasena = false;
    private string tipoPassword => mostrarContrasena ? "text" : "password";
    private string iconoPassword => mostrarContrasena ? "bi-eye-slash" : "bi-eye";

    protected override async Task OnInitializedAsync()
    {
        personal = await personalService.Buscar(PersonalId);
    }

    public async Task Guardar()
    {
        if (await personalService.ExisteCorreo(personal!.Correo, personal.Id))
        {
            toastService.ShowError("Ya existe personal con ese correo.");
            return;
        }

        var modificado = await personalService.Guardar(personal);

        if (modificado)
        {
            toastService.ShowSuccess("¡Personal actualizado exitosamente!");
            navigationManager.NavigateTo("/personal");
        }
        else
        {
            toastService.ShowError("No se pudo actualizar el personal...");
        }
    }

    private async Task Eliminar()
    {
        bool eliminado = await personalService.Eliminar(personal.Id);

        if (eliminado)
        {
            toastService.ShowSuccess("Personal Eliminado Exitosamente");
            navigationManager.NavigateTo("/personal");
        }
        else
        {
            toastService.ShowError("Error al Eliminar el personal");
        }
    }

    private void AlternarMostrarContrasena()
    {
        mostrarContrasena = !mostrarContrasena;
    }
}