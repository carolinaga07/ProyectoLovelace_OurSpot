
@page "/personal/edit/{Id:int}"
@rendermode InteractiveServer

<PageTitle>Editar Personal</PageTitle>

<div class="container mt-4">

    <div class="card shadow-lg">

        <div class="card-header text-center">
            <h3 class="card-title">Editar Personal</h3>
        </div>

        <div class="card-body">

            @* Id *@
            <div class="mb-3">
                <label class="form-label">
                    <strong>Id</strong>
                </label>

                <input type="number"
                       class="form-control"
                       value="@Id"
                       readonly />
            </div>

            @* Nombre *@
            <div class="mb-3">
                <label class="form-label">
                    <strong>Nombre</strong>
                </label>

                <input type="text"
                       class="form-control"
                       @bind="nombre" />
            </div>

            @* Correo *@
            <div class="mb-3">
                <label class="form-label">
                    <strong>Correo electrónico</strong>
                </label>

                <input type="email"
                       class="form-control"
                       @bind="correo" />
            </div>

            @* Cargo *@
            <div class="mb-3">
                <label class="form-label">
                    <strong>Cargo</strong>
                </label>

                <select class="form-select" @bind="cargo">

                    <option value="Administrador">
                        Administrador
                    </option>

                    <option value="Empleado">
                        Empleado
                    </option>

                </select>
            </div>

            @* Estado *@
            <div class="mb-3">
                <label class="form-label">
                    <strong>Estado</strong>
                </label>

                <select class="form-select" @bind="estado">

                    <option value="Activo">Activo</option>
                    <option value="Inactivo">Inactivo</option>

                </select>
            </div>

        </div>

        @* Footer *@
        <div class="card-footer text-center">

            <a href="/personal"
               class="btn btn-secondary me-2">

                <span class="bi bi-arrow-left"></span>
                Volver
            </a>

            <a href="/personal"
               class="btn btn-primary">

                <span class="bi bi-floppy"></span>
                Guardar
            </a>

        </div>

    </div>

</div>

@code {

