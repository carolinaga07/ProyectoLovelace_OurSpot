@page "/personal/edit/{PersonalId:int}"
@rendermode InteractiveServer
@inject PersonalService personalService
@inject ToastService toastService
@inject NavigationManager navigationManager

<PageTitle>Editar Personal</PageTitle>

@if (personal == null)
{
    <p class="text-center">Cargando...</p>
}
else
{
    <EditForm Model="personal" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />

        <div class="container">
            <div class="card shadow-lg">
                <div class="card-header text-center">
                    <h5 class="card-title">Editar Personal</h5>
                </div>

                <div class="card-body">

                    <div class="mb-3">
                        <label class="form-label"><strong>Nombre</strong></label>
                        <InputText class="form-control" @bind-Value="personal.Nombre"></InputText>
                        <ValidationMessage For="(() => personal.Nombre)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><strong>Correo</strong></label>
                        <InputText class="form-control" @bind-Value="personal.Correo"></InputText>
                        <ValidationMessage For="(() => personal.Correo)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><strong>Cargo</strong></label>
                        <InputSelect class="form-select" @bind-Value="personal.Cargo">
                            <option value="Administrador">Administrador</option>
                            <option value="Empleado">Empleado</option>
                        </InputSelect>
                        <ValidationMessage For="(() => personal.Cargo)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><strong>Estado</strong></label>
                        <InputSelect class="form-select" @bind-Value="personal.Estado">
                            <option value="Activo">Activo</option>
                            <option value="Inactivo">Inactivo</option>
                        </InputSelect>
                    </div>
                </div>

                <div class="card-footer text-center mt-2">
                    <a href="/personal" class="btn btn-secondary"><span class="bi bi-arrow-left"></span> Volver</a>
                    <button type="submit" class="btn btn-primary bi bi-floppy"> Guardar</button>
                </div>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int PersonalId { get; set; }

    private Personal? personal;

    protected override async Task OnInitializedAsync()
    {
        personal = await personalService.Buscar(PersonalId);
    }

    public async Task Guardar()
    {
        if (await personalService.ExisteCorreo(personal!.Correo, personal.Id))
        {
            toastService.ShowError("Ya existe personal con ese correo.");
            return;
        }

        var modificado = await personalService.Guardar(personal);

        if (modificado)
        {
            toastService.ShowSuccess("¡Personal actualizado exitosamente!");
            navigationManager.NavigateTo("/personal");
        }
        else
        {
            toastService.ShowError("No se pudo actualizar el personal...");
        }
    }
}