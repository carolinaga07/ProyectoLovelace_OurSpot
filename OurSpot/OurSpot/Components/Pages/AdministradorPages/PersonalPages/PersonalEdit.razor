@page "/personal/edit/{PersonalId:int}"
@attribute [Authorize(Roles = "Administrador")]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using OurSpot.Services

@inject PersonalService personalService
@inject RegistroPersonalService registroPersonalService
@inject ToastService toastService
@inject NavigationManager navigationManager

<PageTitle>Editar Personal</PageTitle>

@if (personal == null)
{
    <p class="text-center">Cargando...</p>
}
else
{
    <EditForm Model="personal" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />

        <div class="container">
            <div class="card shadow-lg">

                <div class="card-header">
                    <h4 class="card-title mt-2">
                        <a href="/personal">
                            <i class="bi bi-arrow-left-short fs-1 align-middle"
                               style="color: #2D5056"></i>
                        </a>
                        Modificar Personal
                    </h4>
                </div>

                <div class="card-body">

                    <div class="mb-3">
                        <label class="form-label">
                            <strong>Nombre</strong>
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="personal.Nombre" />

                        <ValidationMessage For="() => personal.Nombre" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            <strong>Correo</strong>
                        </label>

                        <InputText class="form-control"
                                   type="email"
                                   @bind-Value="personal.Correo" />

                        <ValidationMessage For="() => personal.Correo" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            <strong>Cargo</strong>
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="personal.Cargo" />

                        <ValidationMessage For="() => personal.Cargo" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            <strong>Cuenta de usuario</strong>
                        </label>

                        @if (TieneCuenta)
                        {
                            <div class="alert alert-success mb-0">
                                <i class="bi bi-person-check"></i>
                                Este personal tiene una cuenta de usuario.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-person"></i>
                                Este personal no tiene una cuenta de usuario.
                            </div>

                            <div class="form-check">
                                <InputCheckbox class="form-check-input"
                                               @bind-Value="CrearCuenta" />

                                <label class="form-check-label">
                                    Crear cuenta de usuario
                                </label>
                            </div>
                        }
                    </div>

                    @if (TieneCuenta || CrearCuenta)
                    {
                        <div class="mb-3">
                            <label class="form-label">
                                <strong>Rol de acceso</strong>
                            </label>

                            <InputSelect class="form-select"
                                         @bind-Value="personal.Rol">

                                <option value="Empleado">Empleado</option>
                                <option value="Administrador">Administrador</option>

                            </InputSelect>

                            <ValidationMessage For="() => personal.Rol" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                <strong>
                                    @(TieneCuenta ? "Nueva contraseña" : "Contraseña")
                                </strong>
                            </label>

                            <div class="input-group">
                                <InputText class="form-control"
                                           type="@(mostrarContrasena ? "text" : "password")"
                                           @bind-Value="NuevaContrasena"
                                           placeholder="@(TieneCuenta ? "Dejar vacío para mantener la actual" : "Ingrese una contraseña")" />

                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        @onclick="() => mostrarContrasena = !mostrarContrasena">

                                    <i class="bi @(mostrarContrasena ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                <strong>Confirmar contraseña</strong>
                            </label>

                            <div class="input-group">
                                <InputText class="form-control"
                                           type="@(mostrarConfirmarContrasena ? "text" : "password")"
                                           @bind-Value="ConfirmarContrasena"
                                           placeholder="Repita la contraseña" />

                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        @onclick="() => mostrarConfirmarContrasena = !mostrarConfirmarContrasena">

                                    <i class="bi @(mostrarConfirmarContrasena ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                        </div>

                        @if (TieneCuenta)
                        {
                            <small class="text-muted">
                                Si no deseas cambiar la contraseña, deja ambos campos vacíos.
                            </small>
                        }
                        else
                        {
                            <small class="text-muted">
                                La contraseña será necesaria para que el personal pueda iniciar sesión.
                            </small>
                        }
                    }

                    <div class="mb-3">
                        <label class="form-label">
                            <strong>Estado</strong>
                        </label>

                        <InputSelect class="form-select"
                                     @bind-Value="personal.Estado">

                            <option value="Activo">Activo</option>
                            <option value="Inactivo">Inactivo</option>

                        </InputSelect>
                    </div>

                </div>

                <div class="card-footer text-center mt-2">

                    <button type="submit" class="btn btn-primary">
                        <span class="bi bi-floppy"></span>
                        Guardar
                    </button>

                    @if (personal.Rol != "Administrador")
                    {
                        <button type="button"
                                class="btn btn-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#modalEliminar">

                            <span class="bi bi-x-lg"></span>
                            Eliminar
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-danger"
                                disabled
                                title="No se permite eliminar administradores">

                            <span class="bi bi-x-lg"></span>
                            Eliminar
                        </button>
                    }

                </div>

            </div>
        </div>
    </EditForm>

    @* Modal de Eliminación *@

    <div class="modal fade"
         id="modalEliminar"
         tabindex="-1"
         aria-labelledby="modalCerrar"
         aria-hidden="true">

        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="modalCerrar">
                        Confirmación de eliminación
                    </h1>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>
                </div>

                <div class="modal-body">
                    <p>
                        ¿Eliminar a <strong>@personal.Nombre</strong>?
                    </p>
                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            data-bs-dismiss="modal"
                            @onclick="Eliminar">
                        Eliminar
                    </button>

                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int PersonalId { get; set; }

    private Personal? personal;

    private bool CrearCuenta = false;

    private string NuevaContrasena = string.Empty;
    private string ConfirmarContrasena = string.Empty;

    private bool mostrarContrasena = false;
    private bool mostrarConfirmarContrasena = false;

    private bool TieneCuenta =>
        !string.IsNullOrEmpty(personal?.ApplicationUserId);

    protected override async Task OnInitializedAsync()
    {
        personal = await personalService.Buscar(PersonalId);
    }

    public async Task Guardar()
    {
        if (personal == null)
            return;

        personal.Nombre = personal.Nombre.Trim();
        personal.Correo = personal.Correo.Trim();
        personal.Cargo = personal.Cargo.Trim();

        if (await personalService.ExisteCorreo(
            personal.Correo, personal.Id))
        {
            toastService.ShowError(
                "Ya existe personal con ese correo.");

            return;
        }

        // Validar contraseña al crear una cuenta.
        if (!TieneCuenta && CrearCuenta)
        {
            if (string.IsNullOrWhiteSpace(NuevaContrasena))
            {
                toastService.ShowError(
                    "Debes ingresar una contraseña para crear la cuenta.");

                return;
            }

            if (NuevaContrasena != ConfirmarContrasena)
            {
                toastService.ShowError(
                    "Las contraseñas no coinciden.");

                return;
            }
        }

        // Validar contraseña al modificar una cuenta existente.
        if (TieneCuenta)
        {
            if (!string.IsNullOrEmpty(NuevaContrasena) ||
                !string.IsNullOrEmpty(ConfirmarContrasena))
            {
                if (string.IsNullOrWhiteSpace(NuevaContrasena) ||
                    NuevaContrasena != ConfirmarContrasena)
                {
                    toastService.ShowError(
                        "Las contraseñas no coinciden o están incompletas.");

                    return;
                }
            }
        }

        var resultado = await registroPersonalService.Modificar(
            personal.Id,
            personal.Nombre,
            personal.Correo,
            personal.Cargo,
            personal.Rol,
            personal.Estado,
            CrearCuenta,
            string.IsNullOrWhiteSpace(NuevaContrasena)
                ? null
                : NuevaContrasena);

        if (resultado.Succeeded)
        {
            toastService.ShowSuccess(
                "¡Personal actualizado exitosamente!");

            navigationManager.NavigateTo("/personal");
        }
        else
        {
            toastService.ShowError(
                string.Join("; ",
                    resultado.Errors.Select(e => e.Description)));
        }
    }

    private async Task Eliminar()
    {
        if (personal == null)
            return;

        var resultado = await registroPersonalService.Eliminar(
            personal.Id);

        if (resultado.Succeeded)
        {
            toastService.ShowSuccess(
                "Personal eliminado exitosamente.");

            navigationManager.NavigateTo("/personal");
        }
        else
        {
            toastService.ShowError(
                string.Join("; ",
                    resultado.Errors.Select(e => e.Description)));
        }
    }
}
