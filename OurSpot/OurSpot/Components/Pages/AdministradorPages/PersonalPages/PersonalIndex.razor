
@page "/personal"
@rendermode InteractiveServer

<PageTitle>Personal</PageTitle>

<style>
    .grid {
        max-height: 30rem;
        overflow-y: auto;
    }

    .grid table {
        width: 100%;
        border-collapse: collapse;
    }

    .grid th, .grid td {
        padding: 12px;
        text-align: left;
        vertical-align: middle;
    }

    .grid thead {
        position: sticky;
        top: 0;
        background-color: #eee;
        z-index: 1;
    }

    .grid tr:nth-child(even) {
        background: rgba(255,255,255,0.4);
    }

    .text-center {
        text-align: center !important;
    }

    .estado {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 15px;
        font-size: 12px;
    }

    .activo {
        background-color: #dce9df;
        color: #416849;
    }

    .inactivo {
        background-color: #eadede;
        color: #8a4d4d;
    }
</style>

<div class="container">

    <div class="card shadow-lg">

        @* Encabezado *@
        <div class="card-header d-flex justify-content-between align-items-center mb-4">

            <h5 class="card-title align-content-center mt-2">
                Personal
            </h5>

            <a href="/personal/create"
               class="btn btn-primary"
               style="background-color:#2D5056">

                <span class="bi bi-plus-square-dotted"></span>
                Nuevo Personal
            </a>

        </div>

        <div class="card-body">

            @* Labels de filtros *@
            <div class="row">

                <div class="col-3">
                    <label class="col-form-label">
                        <strong>Cargo</strong>
                    </label>
                </div>

                <div class="col-4">
                    <label class="col-form-label">
                        <strong>Estado</strong>
                    </label>
                </div>

                <div class="col-5">
                    <label class="col-form-label">
                        <strong>Búsqueda</strong>
                    </label>
                </div>

            </div>

            @* Filtros *@
            <div class="row align-items-center mb-3">

                @* Cargo *@
                <div class="col-3">

                    <select class="form-select"
                            @bind="FiltroCargo">

                        <option value="">
                            Todos los cargos
                        </option>

                        <option value="Administrador">
                            Administrador
                        </option>

                        <option value="Empleado">
                            Empleado
                        </option>

                    </select>

                </div>

                @* Estado *@
                <div class="col-4">

                    <select class="form-select"
                            @bind="FiltroEstado">

                        <option value="">
                            Todos los estados
                        </option>

                        <option value="Activo">Activo</option>
                        <option value="Inactivo">Inactivo</option>

                    </select>

                </div>

                @* Búsqueda *@
                <div class="col-5">

                    <div class="input-group">

                        <input class="form-control"
                               @bind="FiltroBusqueda"
                               @bind:event="oninput"
                               placeholder="Buscar nombre, correo o Id" />

                        <button type="button"
                                class="btn btn-outline-primary bi bi-search"
                                title="Buscar">
                        </button>

                    </div>

                </div>

            </div>

            @* Tabla *@
            <div class="grid">

                <table class="table table-hover">

                    <thead class="table-light text-black">

                        <tr>
                            <th>Id</th>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Cargo</th>
                            <th>Estado</th>
                            <th class="text-center">Opciones</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var persona in PersonalFiltrado)
                        {
                            <tr>

                                <td>@persona.Id</td>

                                <td>@persona.Nombre</td>

                                <td>@persona.Correo</td>

                                <td>@persona.Cargo</td>

                                <td>
                                    <span class="estado @(persona.Estado == "Activo" ? "activo" : "inactivo")">
                                        @persona.Estado
                                    </span>
                                </td>

                                <td class="text-center">

                                    <a href="@($"/personal/edit/{persona.Id}")"
                                       class="btn btn-outline-primary bi bi-pencil-square"
                                       title="Editar">
                                    </a>

                                    <a href="@($"/personal/eliminar/{persona.Id}")"
                                       class="btn btn-outline-danger bi bi-trash"
                                       title="Eliminar">
                                    </a>

                                </td>

                            </tr>
                        }

                        @if (!PersonalFiltrado.Any())
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted py-4">

                                    No se encontraron registros de personal con los filtros seleccionados.

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

        <div class="card-footer"></div>

    </div>

</div>

@code {

    // Filtros
    private string FiltroCargo { get; set; } = string.Empty;
    private string FiltroEstado { get; set; } = string.Empty;
    private string FiltroBusqueda { get; set; } = string.Empty;

    // Datos de ejemplo
    private List<PersonalItem> listaPersonal = new()
    {
        new PersonalItem
        {
            Id = 1,
            Nombre = "Sharlot Adrian Lopez",
            Correo = "sharlot@gmail.com",
            Cargo = "Administrador",
            Estado = "Activo"
        },

        new PersonalItem
        {
            Id = 2,
            Nombre = "Franshelina Camilo Cabrera",
            Correo = "franshelina@gmail.com",
            Cargo = "Administrador",
            Estado = "Activo"
        },

        new PersonalItem
        {
            Id = 3,
            Nombre = "Carolina Garcia Almanzar",
            Correo = "carolina@gmail.com",
            Cargo = "Administrador",
            Estado = "Activo"
        },

        new PersonalItem
        {
            Id = 4,
            Nombre = "Dharianny Sime María",
            Correo = "dharianny@gmail.com",
            Cargo = "Administrador",
            Estado = "Activo"
        },

        new PersonalItem
        {
            Id = 5,
            Nombre = "Jazmine Arleny Minaya Peralta",
            Correo = "jazmine@gmail.com",
            Cargo = "Administrador",
            Estado = "Activo"
        },

        new PersonalItem
        {
            Id = 6,
            Nombre = "Carlos Martínez",
            Correo = "carlos@gmail.com",
            Cargo = "Empleado",
            Estado = "Activo"
        },

        new PersonalItem
        {
            Id = 7,
            Nombre = "Laura Rodríguez",
            Correo = "laura@gmail.com",
            Cargo = "Empleado",
            Estado = "Inactivo"
        }
    };

    // Filtros por cargo, estado y búsqueda
    private IEnumerable<PersonalItem> PersonalFiltrado =>
        listaPersonal.Where(persona =>

            (string.IsNullOrEmpty(FiltroCargo) ||
             persona.Cargo == FiltroCargo)

            &&

            (string.IsNullOrEmpty(FiltroEstado) ||
             persona.Estado == FiltroEstado)

            &&

            (string.IsNullOrWhiteSpace(FiltroBusqueda) ||
             persona.Nombre.Contains(
                 FiltroBusqueda,
                 StringComparison.OrdinalIgnoreCase
             ) ||
             persona.Correo.Contains(
                 FiltroBusqueda,
                 StringComparison.OrdinalIgnoreCase
             ) ||
             persona.Id.ToString().Contains(FiltroBusqueda.Trim()))

        );

    // Modelo de ejemplo
    private class PersonalItem
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = "";
        public string Correo { get; set; } = "";
        public string Cargo { get; set; } = "";
        public string Estado { get; set; } = "";
    }
}
