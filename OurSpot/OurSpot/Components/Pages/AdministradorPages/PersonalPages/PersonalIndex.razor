
@page "/personal"
@rendermode InteractiveServer

<PageTitle>Personal</PageTitle>

<div class="personal-page">

    @if (!mostrarDetalle)
    {
        @* Encabezado *@
        <div class="personal-header">
            <h1>Personal</h1>

            <a href="/personal/create" class="btn-crear">
                <i class="bi bi-plus-square"></i>
                Crear
            </a>
        </div>

        @* Filtros *@
        <div class="filtros">

            <div class="campo-filtro">
                <label>Cargo</label>

                <select @bind="filtroCargo">
                    <option value="">Todos</option>
                    <option value="Administrador">Administrador</option>
                    <option value="Empleado">Empleado</option>
                </select>
            </div>

            <div class="campo-filtro">
                <label>Estado</label>

                <select @bind="filtroEstado">
                    <option value="">Todos</option>
                    <option value="Activo">Activo</option>
                    <option value="Inactivo">Inactivo</option>
                </select>
            </div>

            <div class="campo-filtro campo-busqueda">
                <label>Búsqueda</label>

                <div class="busqueda">
                    <input type="text"
                           placeholder="Buscar nombre o correo"
                           @bind="busqueda"
                           @bind:event="oninput" />

                    <button type="button" title="Buscar">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>

        </div>

        @* Tabla *@
        <div class="tabla-contenedor">

            <table class="tabla-personal">

                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Cargo</th>
                        <th>Estado</th>
                        <th>Opciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var persona in PersonalFiltrado)
                    {
                        <tr class="fila-personal"
                            @onclick="() => VerDetalle(persona)">

                            <td>@persona.Id</td>
                            <td>@persona.Nombre</td>
                            <td>@persona.Correo</td>
                            <td>@persona.Cargo</td>

                            <td>
                                <span class="estado @(persona.Estado == "Activo" ? "activo" : "inactivo")">
                                    @persona.Estado
                                </span>
                            </td>

                            <td>
                                <div class="opciones">

                                    <a href="@($"/personal/edit/{persona.Id}")"
                                       class="btn-editar"
                                       title="Editar"
                                       @onclick:stopPropagation="true">

                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <button type="button"
                                            class="btn-estado"
                                            title="@(persona.Estado == "Activo" ? "Desactivar" : "Activar")"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => MostrarConfirmacion(persona)">

                                        <i class="bi @(persona.Estado == "Activo" ? "bi-person-x" : "bi-person-check")"></i>
                                    </button>

                                </div>
                            </td>

                        </tr>
                    }

                    @if (!PersonalFiltrado.Any())
                    {
                        <tr>
                            <td colspan="6" class="sin-resultados">
                                No se encontraron registros de personal.
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    }
    else if (personalSeleccionado is not null)
    {
        @* Detalle del personal *@
        <div class="detalle-vista">

            <div class="detalle-header">

                <div>
                    <h1>Detalle del personal</h1>
                    <p>Información del integrante seleccionado</p>
                </div>

                <button type="button"
                        class="cerrar-vista"
                        @onclick="CerrarDetalle">

                    <i class="bi bi-x-lg"></i>
                </button>

            </div>

            <div class="detalle-formulario">

                <div class="detalle-campo">
                    <label>Id</label>

                    <div class="dato">
                        @personalSeleccionado.Id
                    </div>
                </div>

                <div class="detalle-campo">
                    <label>Nombre</label>

                    <div class="dato">
                        @personalSeleccionado.Nombre
                    </div>
                </div>

                <div class="detalle-campo">
                    <label>Correo electrónico</label>

                    <div class="dato">
                        @personalSeleccionado.Correo
                    </div>
                </div>

                <div class="detalle-campo">
                    <label>Teléfono</label>

                    <div class="dato">
                        @personalSeleccionado.Telefono
                    </div>
                </div>

                <div class="detalle-campo">
                    <label>Cargo</label>

                    <div class="dato">
                        @personalSeleccionado.Cargo
                    </div>
                </div>

                <div class="detalle-campo">
                    <label>Fecha de ingreso</label>

                    <div class="dato">
                        @personalSeleccionado.FechaIngreso.ToString("dd/MM/yyyy")
                    </div>
                </div>

                <div class="detalle-campo">
                    <label>Estado</label>

                    <div class="dato">
                        <span class="estado @(personalSeleccionado.Estado == "Activo" ? "activo" : "inactivo")">
                            @personalSeleccionado.Estado
                        </span>
                    </div>
                </div>

                <div class="detalle-acciones">

                    <a href="@($"/personal/edit/{personalSeleccionado.Id}")"
                       class="btn-detalle-editar">

                        <i class="bi bi-pencil-square"></i>
                        Editar personal
                    </a>

                </div>

            </div>

        </div>
    }

</div>

@* Modal de confirmación *@
@if (mostrarModal && personalConfirmacion is not null)
{
    <div class="modal-fondo">

        <div class="modal-personal">

            <div class="modal-header-personal">
                <h2>Datos del Personal</h2>
            </div>

            <div class="modal-body-personal">

                <h3>
                    ¿Desea @(personalConfirmacion.Estado == "Activo" ? "desactivar" : "activar") este usuario?
                </h3>

                <div class="datos-confirmacion">

                    <p>
                        <strong>Id:</strong>
                        @personalConfirmacion.Id
                    </p>

                    <p>
                        <strong>Nombre:</strong>
                        @personalConfirmacion.Nombre
                    </p>

                    <p>
                        <strong>Correo:</strong>
                        @personalConfirmacion.Correo
                    </p>

                    <p>
                        <strong>Cargo:</strong>
                        @personalConfirmacion.Cargo
                    </p>

                    <p>
                        <strong>Estado actual:</strong>
                        @personalConfirmacion.Estado
                    </p>

                </div>

            </div>

            <div class="modal-footer-personal">

                <button type="button"
                        class="btn-volver"
                        @onclick="CerrarModal">

                    <i class="bi bi-arrow-left"></i>
                    Volver
                </button>

                <button type="button"
                        class="btn-confirmar"
                        @onclick="CambiarEstado">

                    <i class="bi bi-check-circle"></i>
                    Confirmar
                </button>

            </div>

        </div>
    </div>
}

