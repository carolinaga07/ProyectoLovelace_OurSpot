            Cargo = "Empleado",
            FechaIngreso = new DateTime(2026, 9, 20),
            Estado = "Inactivo"
        }
    };

    // Aplicar filtros
    private IEnumerable<PersonalItem> PersonalFiltrado =>
        listaPersonal.Where(p =>
            (string.IsNullOrEmpty(filtroCargo) ||
             p.Cargo == filtroCargo) &&

            (string.IsNullOrEmpty(filtroEstado) ||
             p.Estado == filtroEstado) &&

            (string.IsNullOrWhiteSpace(busqueda) ||
             p.Nombre.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ||
             p.Correo.Contains(busqueda, StringComparison.OrdinalIgnoreCase))
        );

    // Mostrar detalle
    private void VerDetalle(PersonalItem persona)
    {
        personalSeleccionado = persona;
        mostrarDetalle = true;
    }

    // Cerrar detalle
    private void CerrarDetalle()
    {
        mostrarDetalle = false;
        personalSeleccionado = null;
    }

    // Mostrar confirmación
    private void MostrarConfirmacion(PersonalItem persona)
    {
        personalConfirmacion = persona;
        mostrarModal = true;
    }

    // Cerrar modal
    private void CerrarModal()
    {
        mostrarModal = false;
        personalConfirmacion = null;
    }

    // Activar o desactivar
    private void CambiarEstado()
    {
        if (personalConfirmacion is not null)
        {
            personalConfirmacion.Estado =
                personalConfirmacion.Estado == "Activo"
                    ? "Inactivo"
                    : "Activo";
        }

        CerrarModal();
    }

    // Modelo de ejemplo
    private class PersonalItem
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = "";
        public string Correo { get; set; } = "";
        public string Telefono { get; set; } = "";
        public string Cargo { get; set; } = "";
        public DateTime FechaIngreso { get; set; }
        public string Estado { get; set; } = "";
    }
}
