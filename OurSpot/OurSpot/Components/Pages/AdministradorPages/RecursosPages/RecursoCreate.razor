
@page "/recursos/create"
@rendermode InteractiveServer

<PageTitle>Crear Recurso</PageTitle>

<div class="container mt-4">

    <div class="card shadow-lg">

        <div class="card-header text-center">
            <h3 class="card-title">Agregar Recurso</h3>
        </div>

        <div class="card-body">

            @* Id *@
            <div class="mb-3">
                <label class="form-label">
                    <strong>Id</strong>
                </label>

                <input type="number"
                       class="form-control"
                       value="6"
                       readonly />
            </div>

            @* Nombre *@
            <div class="mb-3">
                <label class="form-label">
                    <strong>Nombre</strong>
                </label>

                <input type="text"
                       class="form-control"
                       placeholder="Ej. Sillas plegables" />
            </div>

            @* Categoría *@
            <div class="mb-3">
                <label class="form-label">
                    <strong>Categoría</strong>
                </label>

                <select class="form-select">

                    <option value="" selected disabled>
                        Seleccione una categoría
                    </option>

                    <option value="Mobiliario">Mobiliario</option>
                    <option value="Sonido">Sonido</option>
                    <option value="Iluminación">Iluminación</option>
                    <option value="Audiovisual">Audiovisual</option>
                    <option value="Decoración">Decoración</option>
                    <option value="Otros">Otros</option>

                </select>
            </div>

            @* Cantidad *@
            <div class="mb-3">
                <label class="form-label">
                    <strong>Cantidad</strong>
                </label>

                <input type="number"
                       min="1"
                       class="form-control"
                       placeholder="Ej. 150" />
            </div>

            @* Proveedor *@
            <div class="mb-3">
                <label class="form-label">
                    <strong>Proveedor</strong>
                </label>

                <select class="form-select">

                    <option value="" selected disabled>
                        Seleccione un proveedor
                    </option>

                    <option>Eventos del Cibao</option>
                    <option>TecnoEventos</option>
                    <option>AudioPro RD</option>
                    <option>Ilumina RD</option>

                </select>
            </div>

            @* Estado *@
            <div class="mb-3">
                <label class="form-label">
                    <strong>Estado</strong>
                </label>

                <select class="form-select">

                    <option value="" selected disabled>
                        Seleccione un estado
                    </option>

                    <option value="Disponible">Disponible</option>
                    <option value="En uso">En uso</option>
                    <option value="No disponible">No disponible</option>

                </select>
            </div>

        </div>

        @* Footer *@
        <div class="card-footer text-center">

            <a href="/recursos"
               class="btn btn-secondary me-2">

                <span class="bi bi-arrow-left"></span>
                Volver
            </a>

            <a href="/recursos"
               class="btn btn-primary">

                <span class="bi bi-floppy"></span>
                Guardar
            </a>

        </div>

    </div>

</div>
