@page "/Contrataciones/Editar/{IdContratacion:int}"
@rendermode InteractiveServer
@inject ContratacionesService contratacionesService
@inject ToastService toastService
@inject NavigationManager navigationManager

<PageTitle>Modificar Contrataciones</PageTitle>

<EditForm Model="Contratacion" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />
    <div class="container mt-4">
        <div class="card shadow-lg">
            <div class="card-header">
                <h4 class="card-title mt-2">
                    <a href="/Contrataciones"><i class="bi bi-arrow-left-short fs-1 align-middle" style="color: #2D5056"></i></a>  Modificar Contrataci&oacute;n
                </h4>
            </div>

            <div class="card-body">
                @* Servicio *@
                <div class="mb-3">
                    <label class="form-label"><strong>Servicio</strong></label>
                    <input type="text" class="form-control" @bind-value="Contratacion.Servicio" placeholder="Ej. Show del Payaso Bobby" />
                    <ValidationMessage For="() => Contratacion.Servicio" />
                </div>

                @* Proveedor *@
                <div class="mb-3">
                    <label class="form-label"><strong>Proveedor</strong></label>
                    <input type="text" class="form-control" @bind-value="Contratacion.Proveedor" placeholder="Ej. El Buen Sazon" />
                    <ValidationMessage For="() => Contratacion.Proveedor" />
                </div>

                @* Categoria *@
                <div class="mb-3">
                    <label class="form-label"><strong>Categoría</strong></label>
                    <InputSelect class="form-select" @bind-value="Contratacion.Categoria">
                        <option value="" selected disabled>Seleccione una categoría</option>
                        <option value="Refrigeracion">Refrigeraci&oacute;n</option>
                        <option value="Decoracion">Decoraci&oacute;n</option>
                        <option value="Catering">Catering</option>
                        <option value="Entretenimiento">Entretenimiento</option>
                        <option value="Seguridad">Seguridad</option>
                        <option value="Fotografia">Fotograf&iacute;a</option>
                    </InputSelect>
                    <ValidationMessage For="() => Contratacion.Categoria" />
                </div>

                @* Costo *@
                <div class="mb-3">
                    <label class="form-label"><strong>Costo</strong></label>
                    <input type="number" step="0.01" class="form-control" @bind-value="Contratacion.Costo" placeholder="0.00" />
                    <ValidationMessage For="() => Contratacion.Costo" />
                </div>

                @* Estado *@
                <div class="mb-3">
                    <label class="form-label"><strong>Estado</strong></label>
                    <InputSelect class="form-select" @bind-value="Contratacion.Estado">
                        <option selected disabled>Seleccione el estado</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="Activa">Activa</option>
                        <option value="Cancelada">Cancelada</option>
                        <option value="Realizada">Realizada</option>
                    </InputSelect>
                    <ValidationMessage For="() => Contratacion.Estado" />
                </div>
            </div>

            @* Footer con botones de navegación *@
            <div class="card-footer text-center">
                <button type="submit" class="btn btn-primary me-2" style="background-color:#2D5056"> <span class="bi bi-floppy"></span> Guardar </button>
                <button type="button" class="btn btn-primary x-lg" style="background-color:#2D5056" data-bs-toggle="modal" data-bs-target="#modalEliminar"> <span class="bi bi-trash"></span> Eliminar </button>
            </div>
        </div>
    </div>
</EditForm>

@* Modal de Eliminación *@
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalCerrar" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="modalCerrar"> Confirmación de eliminación </h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"> </button>
            </div>

            <div class="modal-body">
                @if (Contratacion != null)
                {
                    <p>¿Desea eliminar la contratación @Contratacion.Servicio?</p>
                }
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"> Cerrar </button>
                <button type="button" class="btn btn-primary" @onclick="Eliminar"> Eliminar </button>
            </div>
        </div>
    </div>
</div>


@code {
    [Parameter]
    public int IdContratacion { get; set; }
    public Contrataciones Contratacion = new Contrataciones();

    protected override async Task OnInitializedAsync()
    {
        var ContratacionEncontrada = await contratacionesService.Buscar(IdContratacion);
        if (ContratacionEncontrada != null)
        {
            Contratacion = ContratacionEncontrada;
        }
    }



    private async Task Modificar()
    {
        bool modificado = await contratacionesService.Guardar(Contratacion);

        if (modificado)
        {
            toastService.ShowSuccess("Contratacion Modificada Exitosamente");
            navigationManager.NavigateTo("/Contrataciones");
        }
        else
        {
            toastService.ShowError("Error al Modificar la Contratacion");
        }
    }

    private async Task Eliminar()
    {
        bool eliminado = await contratacionesService.Eliminar(Contratacion.Id);

        if (eliminado)
        {
            toastService.ShowSuccess("Contratacion Eliminada Exitosamente");
            navigationManager.NavigateTo("/Contrataciones");
        }
        else
        {
            toastService.ShowError("Error al Eliminar la contratacion");
        }
    }
}
