@page "/Contrataciones/Crear"
@rendermode InteractiveServer
@inject ContratacionesService contratacionesService
@inject ToastService toastService
@inject NavigationManager navigationManager

<PageTitle>Crear Contrataciones</PageTitle>

<EditForm Model="Contratacion" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <div class="container mt-4">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h3 class="card-title">Nueva Contrataci&oacute;n</h3>
            </div>

            <div class="card-body">
                @* id *@
                <div class="mb-3">
                    <label class="form-label"><strong>Id</strong></label>
                    <input type="number" class="form-control" @bind-value="Contratacion.Id" readonly />
                </div>

                @* Evento *@
                <div class="mb-3">
                    <label class="form-label"><strong>Evento</strong></label>
                    <input type="text" class="form-control" @bind-value="Contratacion.Evento" placeholder="Ej. Feria Municipal Santa Clara" />
                </div>

                @* Proveedor *@
                <div class="mb-3">
                    <label class="form-label"><strong>Proveedor</strong></label>
                    <input type="text" class="form-control" @bind-value="Contratacion.Proveedor" placeholder="Ej. El Buen Sazon" />
                </div>

                @* Fecha *@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha</strong></label>
                    <input type="date" class="form-control" @bind-value="Contratacion.Fecha" placeholder="Ej. 18/10/2026" />
                </div>

                @* Servicio *@
                <div class="mb-3">
                    <label class="form-label"><strong>Servicio</strong></label>
                    <InputSelect class="form-select" @bind-value="Contratacion.Servicio">
                        <option value="" selected disabled>Seleccione un servicio</option>
                        <option value="Refrigeracion">Refrigeraci&oacute;n</option>
                        <option value="Decoracion">Decoraci&oacute;n</option>
                        <option value="Catering">Catering</option>
                        <option value="Entretenimiento">Entretenimiento</option>
                        <option value="Seguridad">Seguridad</option>
                        <option value="Fotografia">Fotograf&iacute;a</option>
                    </InputSelect>
                </div>

                @* Costo *@
                <div class="mb-3">
                    <label class="form-label"><strong>Costo</strong></label>
                    <input type="number" step="0.01" class="form-control" @bind-value="Contratacion.Costo" placeholder="0.00" />
                </div>

                @* Estado *@
                <div class="mb-3">
                    <label class="form-label"><strong>Estado</strong></label>
                    <InputSelect class="form-select" @bind-value="Contratacion.Estado">
                        <option selected disabled>Seleccione el estado</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="Activa">Activa</option>
                        <option value="Cancelada">Cancelada</option>
                        <option value="Realizada">Realizada</option>
                    </InputSelect>
                </div>
            </div>

            @* Footer con botones de navegación *@
            <div class="card-footer text-center">
                <a href="/Contrataciones" class="btn btn-secondary me-2" style="background-color:#2D5056">
                    <span class="bi bi-arrow-left"></span> Cancelar
                </a>
                <button type="submit" class="btn btn-primary" style="background-color:#2D5056"> <span class="bi bi-floppy"></span> Guardar </button>
            </div>
        </div>
    </div>
</EditForm>

@code {
    public Contrataciones Contratacion = new Contrataciones();

    private async Task Guardar()
    {
        bool guardado = await contratacionesService.Guardar(Contratacion);

        if (guardado)
        {
            toastService.ShowSuccess("Contratación Guardada Exitosamente");
            navigationManager.NavigateTo("/Contrataciones");
        }
        else
        {
            if (await contratacionesService.Existe(Contratacion.Id))
            {
                toastService.ShowError("Esta contratación ya fue registrada.");
                return;
            }
            toastService.ShowError("Error al Guardar la Contratación");
        }
    }
}
