@attribute [Authorize(Roles = "Administrador")]
@page "/Contrataciones/Crear"
@rendermode InteractiveServer
@inject ContratacionesService contratacionesService
@inject ProveedorService proveedorService
@inject ToastService toastService
@inject NavigationManager navigationManager

<PageTitle>Crear Contrataciones</PageTitle>
<EditForm Model="Contratacion"
          OnValidSubmit="Guardar"
          OnInvalidSubmit="FormularioInvalido">

    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="container mt-4">
        <div class="card shadow-lg">
            <div class="card-header">
                <h4 class="card-title mt-2">
                    <a href="/Contrataciones"><i class="bi bi-arrow-left-short fs-1 align-middle" style="color: #2D5056"></i></a>  Nueva Contrataci&oacute;n
                </h4>
            </div>

            <div class="card-body">
                @* Servicio *@
                <div class="mb-3">
                    <label class="form-label"><strong>Servicio</strong></label>
                    <InputText class="form-control" @bind-Value="Contratacion.Servicio" />
                    <ValidationMessage For="() => Contratacion.Servicio" />
                </div>

                
               
                @* Proveedor *@
                <div class="mb-3">
                    <label class="form-label">
                        <strong>Proveedor</strong>
                    </label>

                    <InputSelect TValue="int?"
                                 class="form-select"
                                 @bind-Value="Contratacion.ProveedorId"
                                 @bind-Value:after="SeleccionarProveedor">

                        <option value="">Seleccione un proveedor</option>

                        @foreach (var proveedor in ListaProveedores)
                        {
                            <option value="@proveedor.Id">
                                @proveedor.Nombre
                            </option>
                        }

                    </InputSelect>

                    <ValidationMessage For="() => Contratacion.ProveedorId" />
                </div>



                @* Categoria *@
                <div class="mb-3">
                    <label class="form-label"><strong>Categoría</strong></label>
                    <InputSelect class="form-select" @bind-value="Contratacion.Categoria">
                        <option value="" selected disabled>Seleccione una categoría</option>
                        <option value="Refrigeracion">Refrigeraci&oacute;n</option>
                        <option value="Decoracion">Decoraci&oacute;n</option>
                        <option value="Catering">Catering</option>
                        <option value="Entretenimiento">Entretenimiento</option>
                        <option value="Seguridad">Seguridad</option>
                        <option value="Fotografia">Fotograf&iacute;a</option>
                    </InputSelect>
                    <ValidationMessage For="() => Contratacion.Categoria" />
                </div>

                @* Costo *@
                <div class="mb-3">
                    <label class="form-label"><strong>Costo</strong></label>
                    <input type="number" step="0.01" class="form-control" @bind-value="Contratacion.Costo" placeholder="0.00" />
                    <ValidationMessage For="() => Contratacion.Costo" />
                </div>
            </div>

            @* Footer con botones de navegación *@
            <div class="card-footer text-center">
                <button type="submit" class="btn btn-primary" style="background-color:#2D5056"> <span class="bi bi-floppy"></span> Guardar </button>
            </div>
        </div>
    </div>
</EditForm>

@code {
    public Contrataciones Contratacion = new Contrataciones();
    public List<Proveedores> ListaProveedores { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        ListaProveedores = await proveedorService
            .GetList(p => !p.Eliminado);
    }
   
    private async Task Guardar()
    {
        var proveedorSeleccionado = ListaProveedores
            .FirstOrDefault(p => p.Id == Contratacion.ProveedorId
                                 && !p.Eliminado);

        if (proveedorSeleccionado is null)
        {
            toastService.ShowError(
                "Debe seleccionar un proveedor válido.");
            return;
        }

        // Conservamos el nombre para compatibilidad
        // con las páginas existentes.
        Contratacion.Proveedor = proveedorSeleccionado.Nombre;

        bool guardado = await contratacionesService
            .Guardar(Contratacion);

        if (guardado)
        {
            toastService.ShowSuccess(
                "Contratación Guardada Exitosamente");

            navigationManager.NavigateTo("/Contrataciones");
        }
        else
        {
            toastService.ShowError(
                "Error al Guardar la Contratación");
        }
    }

    
    private void SeleccionarProveedor()
    {
        var proveedorId = Contratacion.ProveedorId;

        var proveedor = ListaProveedores
            .FirstOrDefault(p => p.Id == proveedorId);

        Contratacion.Proveedor = proveedor?.Nombre ?? string.Empty;
    }

    private void FormularioInvalido()
    {
        toastService.ShowError(
            "El formulario contiene errores de validación.");
    }
}
