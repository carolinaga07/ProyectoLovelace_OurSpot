@page "/Contrataciones/Crear"
@rendermode InteractiveServer
@inject ContratacionesService contratacionesService
@inject ProveedorService proveedorService
@inject ToastService toastService
@inject NavigationManager navigationManager

<PageTitle>Crear Contrataciones</PageTitle>
<EditForm>
    <DataAnnotationsValidator />
    <div class="container mt-4">
        <div class="card shadow-lg">
            <div class="card-header">
                <h4 class="card-title mt-2">
                    <a href="/Contrataciones"><i class="bi bi-arrow-left-short fs-1 align-middle" style="color: #2D5056"></i></a>  Nueva Contrataci&oacute;n
                </h4>
            </div>

            <div class="card-body">
                @* Servicio *@
                <div class="mb-3">
                    <label class="form-label"><strong>Servicio</strong></label>
                    <input type="text" class="form-control" @bind-value="Contratacion.Servicio" placeholder="Ej. Show del Payaso Bobby" />
                    <ValidationMessage For="() => Contratacion.Servicio"/>
                </div>

                @* Proveedor *@
                <div class="mb-3">
                    <label class="form-label"><strong>Proveedor</strong></label>

                    <InputSelect class="form-select" @bind-Value="Contratacion.Proveedor">
                        <option value="">Seleccione un proveedor</option>

                        @foreach (var proveedor in ListaProveedores)
                        {
                            <option value="@proveedor.Nombre">@proveedor.Nombre</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Contratacion.Proveedor" />
                </div>

                @* Categoria *@
                <div class="mb-3">
                    <label class="form-label"><strong>Categoría</strong></label>
                    <InputSelect class="form-select" @bind-value="Contratacion.Categoria">
                        <option value="" selected disabled>Seleccione una categoría</option>
                        <option value="Refrigeracion">Refrigeraci&oacute;n</option>
                        <option value="Decoracion">Decoraci&oacute;n</option>
                        <option value="Catering">Catering</option>
                        <option value="Entretenimiento">Entretenimiento</option>
                        <option value="Seguridad">Seguridad</option>
                        <option value="Fotografia">Fotograf&iacute;a</option>
                    </InputSelect>
                    <ValidationMessage For="() => Contratacion.Categoria" />
                </div>

                @* Costo *@
                <div class="mb-3">
                    <label class="form-label"><strong>Costo</strong></label>
                    <input type="number" step="0.01" class="form-control" @bind-value="Contratacion.Costo" placeholder="0.00" />
                    <ValidationMessage For="() => Contratacion.Costo" />
                </div>
            </div>

            @* Footer con botones de navegación *@
            <div class="card-footer text-center">
                <button type="submit" class="btn btn-primary" style="background-color:#2D5056"> <span class="bi bi-floppy"></span> Guardar </button>
            </div>
        </div>
    </div>
</EditForm>

@code {
    public Contrataciones Contratacion = new Contrataciones();
    public List<Proveedores> ListaProveedores { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var proveedores = await proveedorService.GetList(p => true);
        ListaProveedores = proveedores;
    }

    private async Task Guardar()
    {
        bool guardado = await contratacionesService.Guardar(Contratacion);

        if (guardado)
        {
            toastService.ShowSuccess("Contratación Guardada Exitosamente");
            navigationManager.NavigateTo("/Contrataciones");
        }
        else
        {
            if (await contratacionesService.Existe(Contratacion.ContratacionId))
            {
                toastService.ShowError("Esta contratación ya fue registrada.");
                return;
            }
            toastService.ShowError("Error al Guardar la Contratación");
        }
    }
}
