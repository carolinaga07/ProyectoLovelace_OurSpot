@page "/Home"
@inject EventosService eventosService
@inject ContratacionesService contratacionesService


<div class="container-fluid p-4">
    <div class="d-flex gap-3 mb-4">

        <div class="card text-white p-3" style="background:#2c4a52; flex:1">
            <span>Eventos Proximos</span>
            <span class="fs-1 fw-bold">@ListaEventos.Count</span>
        </div>

        <div class="card text-white p-3" style="background:#2c4a52; flex:1">
            <span>Contrataciones Activas</span>
            <span class="fs-1 fw-bold">14</span>
        </div>

        <div class="card text-white p-3" style="background:#2c4a52; flex:1">
            <span>Proveedores Activos</span>
            <span class="fs-1 fw-bold">20</span>
        </div>

        <div class="card text-white p-3" style="background:#2c4a52; flex:1">
            <span>Lugares Disponibles</span>
            <span class="fs-1 fw-bold">5</span>
        </div>

    </div>

    <h2>Eventos Destacados</h2>
    <div class="d-flex gap-3 pb-2" style="overflow-x:auto">
        @foreach(var evento in ListaDestacados)
        {
            <div class="card" style="min-width:220px; flex-shrink:0">
                <div style="height:180px; background:#8fa8b0"></div>
                <div class="card-body">
                    <h5 class="card-title">@evento.Nombre</h5>
                    <p class="mb-1 small">Ubicacion: @evento.Lugar</p>
                    <p class="mb-1 small">Tipo de evento: @evento.Tipo</p>
                    <span class="fs-1 fw-bold">@TotalContrataciones</span>
                    <span class="fs-1 fw-bold">@TotalProveedores</span>
                    <span class="fs-1 fw-bold">@TotalLugares</span>
                    <p>Estrellas @evento.Estrella.ToString("N0") <i class="bi bi-star-fill text-danger"></i></p>
                    <a href="/eventos/detalle/@evento.EventoId" class="btn btn-outline-dark btn-sm"> Leer mas</a>
                </div>
            </div>
        }
    </div>

    
    <div class="container mt-4">
        <div class="card-header">
            <h2>Eventos Proximos a Realizar</h2>
        </div>
       <div class="card-body">
            <QuickGrid Items="ListaEventos.AsQueryable()" class="table table-hover">
                <PropertyColumn Property="e => e.Nombre" title="Evento" Sortable="true"></PropertyColumn>
                <PropertyColumn Property="e => e.FechaInicio" title="Fecha" Format="dd/MM/yyyy" Sortable="true"></PropertyColumn>
                <PropertyColumn Property="e => e.Lugar" title="Lugar" Sortable="true"></PropertyColumn>
                <PropertyColumn Property="e => e.Tipo" title="Tipo" Sortable="true"></PropertyColumn>
                <TemplateColumn>
                    <a href="/eventos/detalle/@context.EventoId" class="btn btn-teal btn-sm text-white" style="background-color:#2D5056"> Ver detalles</a>
                </TemplateColumn>
            </QuickGrid>
       </div>
    </div>
</div>



@code {
    public List<Evento> ListaEventos { get; set; } = new ();
    public List<Evento> ListaDestacados { get; set; } = new();
    public Evento evento { get; set; } = new();
    public int TotalContrataciones { get; set; }
    public int TotalProveedores { get; set; }
    public int TotalLugares{ get; set; }


    protected override async Task OnInitializedAsync()
    {
        var hoy = DateOnly.FromDateTime(DateTime.Today);

        var eventos = await eventosService.GetList(e => e.FechaInicio >= hoy && e.Estado != "Cancelado" && !e.Eliminado);
        ListaEventos = eventos.OrderBy(e => e.FechaInicio).ToList();

        var finalizados = await eventosService.GetList(e => e.Estado == "Realizado" && !e.Eliminado);
        ListaDestacados = finalizados.OrderByDescending(e => e.Estrella).Take(5).ToList();

        TotalContrataciones = (await contratacionesService.GetList(c => c.Estado == "Activa")).Count;

    }

} 
