@page "/Servicios"

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    .servicios-container {
        padding: 0.4rem;
        min-height: 100vh;
        font-family: sans-serif;
        color: #1a1a1a;
    }

    .servicios-container h1 {
        font-size: 2.2rem;
        font-weight: 700;
        margin-bottom: 0.2rem;
    }

    .servicios-container p {
        font-size: 1.2rem;
        color: #333;
    }

    .buttons-grid {
        display: grid;
        grid-template-columns: repeat(3, 180px); 
        justify-content: center;
        gap: 2.5rem 3rem;
        margin-top: 2rem;
    }

    .service-card {
        background: transparent;
        border: none;
        padding: 0;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        transition: transform 0.2s ease;
        text-decoration: none;
    }

    .service-card:hover {
        transform: translateY(-4px);
    }
    .icon-box {
        width: 100%;
        height: 110px;
        border-radius: 18px; 
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.5rem;
    }

    .icon-box i {
        font-size: 3rem;
        opacity: 0.65; 
    }

    .service-card p {
        font-size: 1.1rem;
        font-weight: 500;
        color: #1a1a1a;
        margin: 0;
        text-align: center;
    }

    .bg-refrigeracion   { background-color: #BDD299; } 
    .bg-refrigeracion i { color: #466D1D; }        

    .bg-decoracion      { background-color: #EEBAB7; } 
    .bg-decoracion i    { color: #9B4443; }

    .bg-catering        { background-color: #EEE1B7; } 
    .bg-catering i      { color: #9B8943; }

    .bg-entretenimiento { background-color: #BAA8D6; } 
    .bg-entretenimiento i { color: #57357D; }

    .bg-seguridad       { background-color: #A8C7D6; }
    .bg-seguridad i     { color: #355C7D; }

    .bg-fotografia      { background-color: #8e8e8e; } 
    .bg-fotografia i    { color: #2D3235; }

    </style>

   
<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header">
            <h3 class="card-title">Cat&aacute;logo de Paquetes</h3>
            <h6>Filtre los eventos seg&uacute;n su categoría de inter&eacutes:</h6>
        </div>
    
    <div class="buttons-grid d-flex justify-content-evenly align-items: center p-3 bg-light">
        <a href="/Servicios/Refrigeracion" class="service-card">
            <div class="icon-box bg-refrigeracion">
                    <i class="bi bi-calendar-heart"></i>
            </div>
                <p>Aniversario</p>
        </a>

        <a href="/Servicios/Decoracion" class="service-card">
            <div class="icon-box bg-decoracion">
                   <i class="bi bi-hearts"></i>
            </div>
            <p>Boda</p>
        </a>

        <a href="/Servicios/Catering" class="service-card">
            <div class="icon-box bg-catering">
                   <i class="fa-solid fa-cake-candles"></i>
            </div>
            <p>Cumplea&ntilde;os</p>
        </a>

        <a href="/Servicios/Entretenimiento" class="service-card">
            <div class="icon-box bg-entretenimiento">
                    <i class="fa-solid fa-church"></i>
            </div>
                <p>Celebraci&oacute;n Religiosa</p>
        </a>

        <a href="/Servicios/Seguridad" class="service-card">
            <div class="icon-box bg-seguridad">
                    <i class="fa-solid fa-user-graduate"></i>
            </div>
                <p>Graduaci&oacute;n</p>
        </a>

        <a href="/Servicios/Fotografia" class="service-card">
            <div class="icon-box bg-fotografia">
                   <i class="fa-solid fa-skull"></i>
            </div>
            <p>Funeral</p>
        </a>


    </div>
    </div>
</div>
