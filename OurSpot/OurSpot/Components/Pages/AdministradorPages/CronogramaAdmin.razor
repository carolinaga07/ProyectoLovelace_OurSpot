            Fecha = new DateTime(2026, 9, 25),
            Hora = new TimeSpan(17, 30, 0),
            Direccion = "Av. Libertad, SFM",
            PersonasRegistradas = null,
            Estado = "Cancelado"
        },

        new EventoCronograma
        {
            Nombre = "SFM Fashion Night",
            Empresa = "SFM Events",
            Evento = "-",
            Fecha = new DateTime(2026, 9, 25),
