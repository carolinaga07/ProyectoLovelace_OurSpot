@page "/administrador/cronograma"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador")]

@using Microsoft.AspNetCore.Authorization
@using OurSpot.Models
@using OurSpot.Models.DTOs
@using OurSpot.Components.Shared.Calendario
@using OurSpot.Components.Pages.AdministradorPages.EventosPages.Services

@inject EventosService eventosService

<PageTitle>Calendario de eventos</PageTitle>

@if (cargando)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-3">Cargando calendario...</p>
    </div>
}
else if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}
else
{
    <CalendarioCompartido Items="@ItemsCalendario"
                          Titulo="Calendario de eventos"
                          Descripcion="Consulta los eventos registrados y sus fechas."
                          MostrarFiltroEstado="true" />
}

@code {
    private List<CalendarioItemDto> ItemsCalendario = new();

    private bool cargando = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var eventos = await eventosService
                .GetList(e => !e.Eliminado);

            ItemsCalendario = ConvertirEventosCalendario(eventos);
        }
        catch (Exception ex)
        {
            error = "No se pudieron cargar los eventos.";
            Console.WriteLine(ex);
        }
        finally
        {
            cargando = false;
        }
    }

    private List<CalendarioItemDto> ConvertirEventosCalendario(
        List<Evento> eventos)
    {
        return eventos.Select(e => new CalendarioItemDto
        {
            Id = e.EventoId,
            EventoId = e.EventoId,

            Titulo = e.Nombre,
            NombreEvento = e.Nombre,
            Descripcion = e.Descripcion,
            Lugar = e.Lugar,

            Fecha = e.FechaInicio,
            Hora = e.HoraInicio,

            Estado = e.Estado,
            Tipo = "Evento",

            UrlDetalle =
                $"/eventos/detalle/{e.EventoId}"

        }).ToList();
    }
}
