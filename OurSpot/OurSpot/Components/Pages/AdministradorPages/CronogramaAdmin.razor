@page "/cronograma"
@rendermode InteractiveServer

<PageTitle>Cronograma</PageTitle>

<div class="cronograma-page">

    @* Panel Próximamente *@
    @if (VistaActual == "principal")
    {
        <section class="panel-eventos">

            <h2>Próximamente</h2>

            <div class="lista-eventos">

                @foreach (var evento in Eventos.OrderBy(e => e.Fecha).ThenBy(e => e.Hora))
                {
                    <div class="evento">

                        <div class="evento-nombre">
                            <span class="punto"></span>
                            <strong>@evento.Nombre</strong>
                        </div>

                        <span class="evento-fecha">
                            @ObtenerFechaProxima(evento)
                        </span>

                    </div>
                }
            </div>
        </section>
    }


    @* Calendario *@
    <section class="calendario">

        @* Encabezado *@
        <div class="calendario-header">

            <h1>@NombreMes @AnioActual</h1>

            <div class="controles">

                @* Filtro por mes *@
                <div class="filtro">

                    <button type="button"
                            @onclick="MostrarFiltroMes">
                        Mes
                        <i class="bi bi-chevron-down"></i>
                    </button>

                    @if (FiltroMesVisible)
                    {
                        <div class="filtro-menu filtro-meses">

                            @foreach (var mes in Meses)
                            {
                                <button type="button"
                                        class="opcion-filtro @(mes.Numero == MesActual ? "seleccionado" : "")"
                                        @onclick="() => SeleccionarMes(mes.Numero)">

                                    @mes.Nombre

                                </button>
                            }

                        </div>
                    }

                </div>


                @* Filtro por año *@
                <div class="filtro">

                    <button type="button"
                            @onclick="MostrarFiltroAnio">
                        Año
                        <i class="bi bi-chevron-down"></i>
                    </button>

                    @if (FiltroAnioVisible)
                    {
                        <div class="filtro-menu">

                            @foreach (var anio in Anios)
                            {
                                <button type="button"
                                        class="opcion-filtro @(anio == AnioActual ? "seleccionado" : "")"
                                        @onclick="() => SeleccionarAnio(anio)">
                                    @anio
                                </button>
                            }
                        </div>
                    }
                </div>

                @* Mes anterior *@
                <button type="button"
                        class="flecha"
                        @onclick="MesAnterior">
                    &lt;
                </button>

                @* Mes siguiente *@
                <button type="button"
                        class="flecha"
                        @onclick="MesSiguiente">
                    &gt;
                </button>

            </div>

        </div>

        @* Días de la semana *@
        <div class="dias-semana">
            <span>Domingo</span>
            <span>Lunes</span>
            <span>Martes</span>
            <span>Miércoles</span>
            <span>Jueves</span>
            <span>Viernes</span>
            <span>Sábado</span>
        </div>

        @* Días del calendario *@
        <div class="calendario-grid">

            @foreach (var dia in DiasCalendario)
            {
                <div class="dia @(dia.EsDelMesActual ? "" : "otro-mes")"
                     @onclick="() => SeleccionarDia(dia)">

                    <span class="numero-dia">
                        @dia.Numero
                    </span>

                    @if (dia.EsDelMesActual)
                    {
                        @foreach (var evento in ObtenerEventosDia(dia.Numero))
                        {
                            <div class="evento-calendario"
                                 @onclick:stopPropagation="true"
                                 @onclick="() => MostrarDetalleDesdeCalendario(evento)">

                                @evento.Nombre

                            </div>
                        }
                    }

                </div>
            }
        </div>
    </section>

    @* Panel del día *@
    @if (VistaActual == "dia" && FechaSeleccionada != null)
    {
        <section class="panel-eventos panel-dia">

            <div class="titulo-panel">

                <h2>
                    @FechaSeleccionada.Value.Day de
                    @NombreMesCorto(FechaSeleccionada.Value)
                </h2>

                <button type="button"
                        class="cerrar-panel"
                        @onclick="CerrarPanel">
                    ×
                </button>

            </div>

            @{
                var eventosDia = Eventos
                    .Where(e => e.Fecha.Date == FechaSeleccionada.Value.Date)
                    .OrderBy(e => e.Hora)
                    .ToList();
            }

            @if (eventosDia.Any())
            {
                <div class="lista-eventos">

                    @foreach (var evento in eventosDia)
                    {
                        <div class="evento evento-seleccionable"
                             @onclick="() => MostrarDetalle(evento)">

                            <div class="evento-nombre">
                                <span class="punto"></span>
                                <strong>@evento.Nombre</strong>
                            </div>

                            <span class="evento-fecha">
                                @ObtenerHora(evento.Hora)
                            </span>

                        </div>
                    }

                </div>
            }
            else
            {
                <p class="sin-eventos">
                    No hay eventos agendados
                </p>
            }

        </section>
    }

    @* Panel Detalle *@
    @if (VistaActual == "detalle" && EventoSeleccionado != null)
    {
        <section class="panel-eventos panel-detalle">

            <div class="titulo-panel">

                <h2>Detalle</h2>

                <button type="button"
                        class="volver-panel"
                        @onclick="VolverAlDia">
                    <i class="bi bi-arrow-left-short"></i>
                </button>

            </div>

            <div class="detalle">

                <div class="detalle-campo">
                    <strong>Empresa:</strong>
                    <span>@EventoSeleccionado.Empresa</span>
                </div>

                <div class="detalle-campo">
                    <strong>Evento:</strong>
                    <span>@EventoSeleccionado.Evento</span>
                </div>

                <div class="detalle-campo">
                    <strong>Fecha:</strong>

                    <span>
                        @EventoSeleccionado.Fecha.Day
                        @NombreMesCompleto(EventoSeleccionado.Fecha)
                        de @EventoSeleccionado.Fecha.Year
                    </span>
                </div>

                <div class="detalle-campo">
                    <strong>Hora:</strong>
                    <span>@ObtenerHora(EventoSeleccionado.Hora)</span>
                </div>

                <div class="detalle-campo">
                    <strong>Dirección:</strong>
                    <span>@EventoSeleccionado.Direccion</span>
                </div>

                <div class="detalle-campo">
                    <strong>Personas registradas:</strong>

                    @if (EventoSeleccionado.PersonasRegistradas.HasValue)
                    {
                        <span>
                            @EventoSeleccionado.PersonasRegistradas
                        </span>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </div>

                <div class="detalle-campo">
                    <strong>Estado:</strong>
                    <span>@EventoSeleccionado.Estado</span>
                </div>

            </div>
        </section>
    }

</div>


@code {
    // Mes y año actual
