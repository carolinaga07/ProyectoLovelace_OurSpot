            Direccion = "Av. Libertad, SFM",
            PersonasRegistradas = 126,
            Estado = "Disponible"
        },

        new EventoCronograma
        {
            Nombre = "Decoraciones Elegance",
            Empresa = "Elegance Eventos",
            Evento = "Taller de Pintura",
            Fecha = new DateTime(2026, 9, 29),
            Hora = new TimeSpan(16, 0, 0),
            Direccion = "Centro Cultural La Nave, SFM",
            PersonasRegistradas = null,
            Estado = "Pendiente"
        },

        new EventoCronograma
        {
            Nombre = "Sonido AudioMax",
            Empresa = "AudioMax Producciones",
            Evento = "Taller de Pintura",
            Fecha = new DateTime(2026, 9, 29),
            Hora = new TimeSpan(16, 0, 0),
            Direccion = "Centro Cultural La Nave, SFM",
            PersonasRegistradas = null,
            Estado = "Pendiente"
        }
    };

    // Nombre del mes
    private string NombreMes
    {
        get
        {
            DateTime fecha = new DateTime(AnioActual, MesActual, 1);

            string nombre = fecha.ToString("MMMM", new System.Globalization.CultureInfo("es-ES"));

            return char.ToUpper(nombre[0]) + nombre.Substring(1);
        }
    }

    // Generación de los días del calendario
    private List<DiaCalendario> DiasCalendario
    {
        get
        {
            var dias = new List<DiaCalendario>();

            DateTime primerDia = new DateTime(AnioActual, MesActual, 1);

            int cantidadDias = DateTime.DaysInMonth(AnioActual, MesActual);

            int posicionPrimerDia = (int)primerDia.DayOfWeek;

            // Mes anterior
            DateTime fechaMesAnterior = primerDia.AddMonths(-1);

            int cantidadDiasMesAnterior =DateTime.DaysInMonth(fechaMesAnterior.Year, fechaMesAnterior.Month);

            for (int i = posicionPrimerDia - 1; i >= 0; i--)
            {
                dias.Add(
                    new DiaCalendario
                    {
                        Numero = cantidadDiasMesAnterior - i,
                        EsDelMesActual = false
                    }
                );
            }

            // Mes actual
            for (int dia = 1; dia <= cantidadDias; dia++)
            {
                dias.Add(
                    new DiaCalendario
                    {
                        Numero = dia,
                        EsDelMesActual = true
                    }
                );
            }

            // Mes siguiente
            int diaSiguiente = 1;

            while (dias.Count < 42)
            {
                dias.Add(
                    new DiaCalendario
                    {
                        Numero = diaSiguiente,
                        EsDelMesActual = false
                    }
                );
                diaSiguiente++;
            }
            return dias;
        }
    }

    // Eventos de un día
    private List<EventoCronograma> ObtenerEventosDia(int dia)
    {
        return Eventos
            .Where(e =>
                e.Fecha.Year == AnioActual &&
                e.Fecha.Month == MesActual &&
                e.Fecha.Day == dia)
            .OrderBy(e => e.Hora)
            .ToList();
    }

    // Seleccionar día
    private void SeleccionarDia(DiaCalendario dia)
    {
        if (!dia.EsDelMesActual)
            return;

        FechaSeleccionada = new DateTime(AnioActual, MesActual, dia.Numero);
        EventoSeleccionado = null;
        VistaActual = "dia";
    }

    // Mostrar detalle
    private void MostrarDetalle(EventoCronograma evento)
    {
        FechaSeleccionada = evento.Fecha;
        EventoSeleccionado = evento;
        VistaActual = "detalle";
    }

    // Mostrar detalle desde calendario
    private void MostrarDetalleDesdeCalendario(EventoCronograma evento)
    {
        FechaSeleccionada = evento.Fecha;
        EventoSeleccionado = evento;
        VistaActual = "detalle";
    }

    // Volver al día
    private void VolverAlDia()
    {
        EventoSeleccionado = null;
        VistaActual = "dia";
    }

    // Cerrar panel
    private void CerrarPanel()
    {
        FechaSeleccionada = null;
        EventoSeleccionado = null;
        VistaActual = "principal";
    }

    // Botones
    private void MesAnterior()
    {
        DateTime fechaActual = new DateTime(AnioActual, MesActual, 1);
        DateTime nuevaFecha = fechaActual.AddMonths(-1);

        MesActual = nuevaFecha.Month;
        AnioActual = nuevaFecha.Year;

        CerrarPanel();
    }

    private void MesSiguiente()
    {
        DateTime fechaActual = new DateTime(AnioActual, MesActual, 1);
        DateTime nuevaFecha = fechaActual.AddMonths(1);

        MesActual = nuevaFecha.Month;
        AnioActual = nuevaFecha.Year;

        CerrarPanel();
    }

    // Fecha del panel Próximamente
    private string ObtenerFechaProxima(EventoCronograma evento)
    {
        string mes = evento.Fecha.ToString("MMM", new System.Globalization.CultureInfo("es-ES"));
        mes = mes.Replace(".", "");
        mes = char.ToUpper(mes[0]) + mes.Substring(1);

        return $"{evento.Fecha.Day} {mes} - {ObtenerHora(evento.Hora)}";
    }

    // Hora
    private string ObtenerHora(TimeSpan hora)
    {
        DateTime fecha = DateTime.Today.Add(hora);

        return fecha.ToString("h:mm tt");
    }

    // Nombre corto del mes
    private string NombreMesCorto(DateTime fecha)
    {
        string nombre = fecha.ToString("MMM", new System.Globalization.CultureInfo("es-ES"));
        nombre = nombre.Replace(".", "");

        return char.ToUpper(nombre[0]) + nombre.Substring(1);
    }

    // Nombre completo del mes
    private string NombreMesCompleto(DateTime fecha)
    {
        string nombre = fecha.ToString("MMMM", new System.Globalization.CultureInfo("es-ES"));

        return char.ToUpper(nombre[0]) + nombre.Substring(1);
    }

    // Casillas del calendario
    private class DiaCalendario
    {
        public int Numero { get; set; }
        public bool EsDelMesActual { get; set; }
    }

    // Datos del cronograma
    private class EventoCronograma
    {
        public string Nombre { get; set; } = "";
        public string Empresa { get; set; } = "";
        public string Evento { get; set; } = "";
        public DateTime Fecha { get; set; }
        public TimeSpan Hora { get; set; }
        public string Direccion { get; set; } = "";
        public int? PersonasRegistradas { get; set; }
        public string Estado { get; set; } = "";
    }

    // Mes del filtro
    private class MesFiltro
    {
        public int Numero { get; set; }
        public string Nombre { get; set; } = "";
    }

    // Filtros
    private bool FiltroMesVisible = false;
    private bool FiltroAnioVisible = false;

    // Meses
    private List<MesFiltro> Meses = new()
    {
        new MesFiltro { Numero = 1, Nombre = "Enero" },
        new MesFiltro { Numero = 2, Nombre = "Febrero" },
        new MesFiltro { Numero = 3, Nombre = "Marzo" },
        new MesFiltro { Numero = 4, Nombre = "Abril" },
        new MesFiltro { Numero = 5, Nombre = "Mayo" },
        new MesFiltro { Numero = 6, Nombre = "Junio" },
        new MesFiltro { Numero = 7, Nombre = "Julio" },
        new MesFiltro { Numero = 8, Nombre = "Agosto" },
        new MesFiltro { Numero = 9, Nombre = "Septiembre" },
        new MesFiltro { Numero = 10, Nombre = "Octubre" },
        new MesFiltro { Numero = 11, Nombre = "Noviembre" },
        new MesFiltro { Numero = 12, Nombre = "Diciembre" }
    };

    // Años
    private List<int> Anios = Enumerable
        .Range(DateTime.Today.Year - 5, 11)
        .ToList();

    // Mostrar filtro de mes
    private void MostrarFiltroMes()
    {
        FiltroMesVisible = !FiltroMesVisible;
        FiltroAnioVisible = false;
    }

    // Mostrar filtro de año
    private void MostrarFiltroAnio()
    {
        FiltroAnioVisible = !FiltroAnioVisible;
        FiltroMesVisible = false;
    }

    // Seleccionar mes
    private void SeleccionarMes(int mes)
    {
        MesActual = mes;
        FiltroMesVisible = false;

        CerrarPanel();
    }

    // Seleccionar año
    private void SeleccionarAnio(int anio)
    {
        AnioActual = anio;
        MesActual = 1;
        FiltroAnioVisible = false;

        CerrarPanel();
    }
}