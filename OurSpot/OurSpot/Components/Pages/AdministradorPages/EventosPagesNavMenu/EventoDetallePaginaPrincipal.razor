@page "/eventos/detalle/{EventoId:int}"
@attribute [Authorize(Roles = "Administrador")]
@rendermode InteractiveServer

@inject EventosService eventosService

<PageTitle>Detalle del Evento</PageTitle>

<div class="container">
    <div class="card shadow-lg">

        <div class="card-header text-center">
            <h5 class="card-title">Detalle del Evento</h5>
        </div>

        @if (cargando)
        {
            <p class="text-center p-4">Cargando evento...</p>
        }
        else if (evento is null)
        {
            <div class="alert alert-warning m-3">
                @mensajeError
            </div>
        }
        else
        {
            <div class="card-body">
                <div class="row">

                    @* Galería de imágenes *@
                    <div class="col-md-7">

                        @if (imagenes.Count == 0)
                        {
                            <div class="d-flex justify-content-center align-items-center bg-light rounded"
                                 style="height:400px;">
                                <div class="text-center text-muted">
                                    <i class="bi bi-image fs-1"></i>
                                    <p>Este evento no tiene fotografías.</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="position-relative">

                                <img src="@UrlImagen(imagenes[indice])"
                                     class="w-100 rounded"
                                     style="height:400px; object-fit:contain;"
                                     alt="Fotografía del evento" />

                                @if (imagenes.Count > 1)
                                {
                                    <button type="button"
                                            class="btn btn-light rounded-circle position-absolute top-50 start-0 ms-2 bi bi-chevron-left"
                                            aria-label="Anterior"
                                            @onclick="Anterior">
                                    </button>

                                    <button type="button"
                                            class="btn btn-light rounded-circle position-absolute top-50 end-0 me-2 bi bi-chevron-right"
                                            aria-label="Siguiente"
                                            @onclick="Siguiente">
                                    </button>
                                }
                            </div>

                            <div class="d-flex flex-wrap gap-2 mt-3">
                                @for (int i = 0; i < imagenes.Count; i++)
                                {
                                    var pos = i;

                                    <button type="button"
                                            class="rounded p-0 overflow-hidden @(pos == indice
                                                ? "border border-primary border-3"
                                                : "border-0")"
                                    style="width:80px; height:60px;"
                                    aria-label="@($"Ver imagen {pos + 1}")"
                                    @onclick="() => indice = pos">

                                <img src="@UrlImagen(imagenes[pos])"
                                     class="w-100 h-100"
                                     style="object-fit:cover;"
                                     alt="Miniatura del evento" />
                            </button>
                        }
                    </div>

                    <p class="text-muted small mt-2">
                        Fotografía @(indice + 1) de @imagenes.Count
                    </p>
                }
            </div>

            @* Información del evento *@
            <div class="col-md-5 mt-4 mt-md-0">
                <h3 class="mb-3">@evento.Nombre</h3>

                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge border text-dark fw-normal">
                        @evento.Tipo
                    </span>
                </div>

                <p>
                    <strong>Categoría:</strong>
                    @evento.Categoria
                </p>

                <p>
                    <strong>Fecha de inicio:</strong>
                    @evento.FechaInicio.ToString("dd/MM/yyyy")
                </p>

                <p>
                    <strong>Hora de inicio:</strong>
                    @evento.HoraInicio.ToString("HH:mm")
                </p>

                <p>
                    <strong>Fecha de cierre:</strong>
                    @evento.FechaCierre.ToString("dd/MM/yyyy")
                </p>

                <p>
                    <strong>Hora de cierre:</strong>
                    @evento.HoraCierre.ToString("HH:mm")
                </p>

                <p>
                    <strong>Lugar:</strong>
                    @evento.Lugar
                </p>

                <p>
                    <strong>Descripción:</strong>
                    @(string.IsNullOrWhiteSpace(evento.Descripcion)
                        ? "Sin descripción."
                        : evento.Descripcion)
                </p>

                <hr />

                <h4>
                    Total: @evento.Total.ToString("C2")
                </h4>
            </div>
        </div>

        @* Contrataciones guardadas *@
        <div class="border border-success p-3 mt-4">
            <h5>Contrataciones del Evento</h5>

            @if (evento.EventosDetalles?.Any() == true)
            {
                <div class="table-responsive">
                    <QuickGrid Items="evento.EventosDetalles.AsQueryable()"
                               class="table table-light text-center">

                        <PropertyColumn Property="d => d.ContratacionId"
                                        Title="Id" />

                        <PropertyColumn Property="d => d.Servicio"
                                        Title="Servicio" />

                        <PropertyColumn Property="d => d.PrecioBase"
                                        Title="Precio base"
                                        Format="C2" />

                        <PropertyColumn Property="d => d.PorcentajeGanancia"
                                        Title="Ganancia (%)" />

                        <PropertyColumn Property="d => d.PrecioFinal"
                                        Title="Precio final"
                                        Format="C2" />

                    </QuickGrid>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    No hay contrataciones cargadas para este evento.
                </p>
            }

            <hr />

            <p class="text-end mb-0">
                <strong>
                    Total: @evento.Total.ToString("C2")
                </strong>
            </p>
        </div>
    </div>
}

<div class="card-footer text-center">
    <a href="/administrador/home" class="btn btn-secondary">
        <span class="bi bi-arrow-left"></span> Volver
    </a>
</div>
</div>
</div>

@code {
    [Parameter]
    public int EventoId { get; set; }

    private Evento? evento;
    private List<EventoImagen> imagenes = new();

    private bool cargando = true;
    private string mensajeError = string.Empty;
    private int indice;

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        evento = null;
        imagenes = new();
        indice = 0;
        mensajeError = string.Empty;

        try
        {
            evento = await eventosService.Buscar(EventoId);

            if (evento is null)
            {
                mensajeError = "El evento solicitado no existe.";
                return;
            }

            imagenes = evento.Imagenes
                .OrderBy(i => i.FechaSubida)
                .ToList();
        }
        catch (Exception)
        {
            mensajeError = "No se pudo cargar la información del evento.";
        }
        finally
        {
            cargando = false;
        }
    }

    private static string UrlImagen(EventoImagen imagen)
    {
        return $"/api/eventos/imagenes/{imagen.EventoImagenId}";
    }

    private void Anterior()
    {
        if (imagenes.Count > 0)
            indice = (indice - 1 + imagenes.Count) % imagenes.Count;
    }

    private void Siguiente()
    {
        if (imagenes.Count > 0)
            indice = (indice + 1) % imagenes.Count;
    }
}
