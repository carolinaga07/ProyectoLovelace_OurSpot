@page "/eventos/edit/{EventoId:int}"
@rendermode InteractiveServer

@inject EventosService eventosService
@inject LugaresService lugaresService
@inject NavigationManager Navigation
@inject ToastService toastService

<PageTitle>Modificar Evento</PageTitle>

<EditForm Model="Evento" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">

            <div class="card-header text-center">
                <h5 class="card-title">Modificar Evento</h5>
            </div>

            <div class="card-body">
                @* Nombre*@
                <div class="mb-3">
                    <label class="form-label"><strong>Nombre</strong></label>
                    <InputText class="form-control" @bind-Value="Evento.Nombre"></InputText>
                    <ValidationMessage For="(() => Evento.Nombre)" />
                </div>

                @*Descripcion*@
                <div class="mb-3">
                    <label class="form-label"><strong>Descripcion</strong></label>
                    <InputText class="form-control" @bind-Value="Evento.Descripcion"></InputText>
                    <ValidationMessage For="(() => Evento.Descripcion)" />
                </div>

                @*Fecha Inicio*@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha Inicio</strong></label>
                    <InputDate class="form-control" @bind-Value="Evento.FechaInicio"></InputDate>
                    <ValidationMessage For="(() => Evento.FechaInicio)" />
                </div>
                 @*Hora Inicio*@
                <div class="mb-3">
                    <label class="form-label"><strong>Hora de Inicio</strong></label>
                    <Input type ="time" class="form-control" @bind="Evento.HoraInicio"/>
                    <ValidationMessage For="(() => Evento.HoraInicio)" />
                </div>

                @*Fecha Cierre*@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha de Cierre</strong></label>
                    <InputDate class="form-control" @bind-Value="Evento.FechaCierre"></InputDate>
                    <ValidationMessage For="(() => Evento.FechaCierre)" />
                </div>
                 @*Hora Cierre*@
                <div class="mb-3">
                    <label class="form-label"><strong>Hora de Cierre</strong></label>
                    <Input type ="time" class="form-control" @bind="Evento.HoraCierre"/>
                    <ValidationMessage For="(() => Evento.HoraCierre)" />
                </div>

                 @*Tipo*@
                <div class="mb-3">
                    <label class="form-label"><strong>Tipo</strong></label>
                    <InputSelect class="form-select" @bind-Value="Evento.Tipo">
                        <option value="" selected disabled>Elija una opcion</option>
                        <option value="Publico">Publico</option>
                        <option value="Privado">Privado</option>
                    </InputSelect>
                </div>

                @*Lugar*@
                <div class="mb-3">
                    <label class="form-label"><strong>Lugar</strong></label>
                    <InputSelect class = "form-control" @bind-Value = "Evento.Lugar">
                        <option value = "">-- Seleccione un lugar: --</option>
                    @if(listaLugares != null)
                    {
                        @foreach (var lugar in listaLugares)
                        {
                            <option value = "@lugar.Nombre">@lugar.Nombre</option>
                        }
                    }
                </InputSelect>
                <ValidationMessage For = "(() => Evento.Lugar)"></ValidationMessage>
                </div>
                </div>

            <div class="card-footer text-center mt-2">
                <a href="/eventos" class="btn btn-secondary me-2"><span class="bi bi-arrow-left"></span> Volver </a>
                <button type="submit" class="btn btn-primary"><span class="bi bi-floppy"></span> Guardar </button>
                <button type ="button" class ="btn btn-danger bi bi-trash" @onclick = "MostrarModal">Eliminar</button>
            </div>
        </div>
    </div>

</EditForm>

    @if (mostrarModal)
    {
     <div class="modal fade show d-block" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header text-black">
                        <h5 class="modal-title">Confirmar Eliminaci&oacute;n</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                    </div>  
                    <div class="modal-body">
                        <p>¿Desea eliminar el evento <strong>@Evento.Nombre</strong>?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                        <button type="button" class="btn btn-danger" @onclick="Eliminar">Eliminar</button>
                    </div>
                </div>
            </div>
        </div>
    }

@code {

    [Parameter]
    public int EventoId { get; set; }

    private Evento Evento { get; set; } = new();

    private bool mostrarModal = false;

    public IQueryable<Lugares> listaLugares;

    protected override async Task OnInitializedAsync()
    {
       var eventoEncontrado = await eventosService.Buscar(EventoId);

        if (eventoEncontrado == null)
        {
            toastService.ShowError("El evento no existe.");
            Navigation.NavigateTo("/eventos");
            return;
        }

        Evento = eventoEncontrado;
        Evento.FechaInicio = DateOnly.FromDateTime(DateTime.Now);
        Evento.FechaCierre = DateOnly.FromDateTime(DateTime.Now);
        var lugares = await lugaresService.GetList( l => l.Id > 0);
        listaLugares = lugares.AsQueryable();
    }


    private async Task Modificar()
    {
        bool modificado = await eventosService.Guardar(Evento);

        if (modificado)
        {
            toastService.ShowSuccess("Se ha modificado correctamente el evento.");

            Navigation.NavigateTo("/eventos");
        }
        else
        {
            toastService.ShowError(
                "No se ha podido modificar el evento satisfactoriamente.");
        }
    }

    public async Task Eliminar()
    {
        
        var eliminado = await eventosService.Eliminar(Evento.EventoId);

        if (eliminado)
        {
            toastService.ShowSuccess("¡Evento eliminado correctamente!");
            Navigation.NavigateTo("/eventos");
        }
        else
        {
            toastService.ShowError("No se ha podido modificar el evento satisfactoriamente.");
        }
    }

    private async Task MostrarModal()
    {
        mostrarModal = true;
    }

    private async Task CerrarModal()
    {
        mostrarModal = false;
    }

}

