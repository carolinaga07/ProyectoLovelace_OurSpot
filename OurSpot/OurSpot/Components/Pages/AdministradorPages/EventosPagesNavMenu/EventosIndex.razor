
@attribute [Authorize(Roles = "Administrador")]
@page "/eventos"
@rendermode InteractiveServer

@inject EventosService eventoService
@inject ToastService toastService

<PageTitle>Eventos</PageTitle>

<style>
    .estado {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 15px;
        font-size: 12px;
    }

    .pendiente {
        background-color: #faf4e3;
        color: #9a8550;
    }

    .activo {
        background-color: #dce9df;
        color: #416849;
    }

    .finalizado {
        background-color: #e0eaf5;
        color: #42678d;
    }

    .cancelado {
        background-color: #f5dddd;
        color: #a34c4c;
    }
</style>

<div class="container-fluid px-3">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center mb-4">
            <h5 class="card-title align-content-center mt-2">Eventos</h5>
            <a href="/eventos/Crear" class="btn btn-primary" style="background-color:#2D5056">
                <span class="bi bi-plus-square-dotted mt-3"></span> Nuevo Evento
            </a>
        </div>

        <div class="card-body">

            @* Labels *@
            <div class="row">
                <div class="col-3">
                    <label class="col-form-label"><strong>Categoría</strong></label>
                </div>

                <div class="col-4">
                    <label class="col-form-label"><strong>Estado</strong></label>
                </div>

                <div class="col-5">
                    <label class="col-form-label"><strong>Búsqueda</strong></label>
                </div>
            </div>

            @* Inputs y botones *@
            <div class="row align-items-center mb-3">
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="FiltroCategoria">
                        <option value="" disabled>Elija una opción</option>
                        <option value="Cultural">Cultural</option>
                        <option value="Social">Social</option>
                        <option value="Empresarial">Empresarial</option>
                        <option value="Deportivo">Deportivo</option>
                    </InputSelect>
                </div>

                <div class="col-4">
                    <InputSelect class="form-select" @bind-Value="FiltroEstado">
                        <option value="" disabled>Elija una opción</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="Activo">Activo</option>
                        <option value="Finalizado">Finalizado</option>
                        <option value="Cancelado">Cancelado</option>
                    </InputSelect>
                </div>

                <div class="col-5">
                    <div class="input-group">
                        <input class="form-control"
                               @bind="FiltroBusqueda"
                               placeholder="Buscar" />

                        <button type="button"
                                class="btn btn-outline-primary bi bi-search">
                        </button>
                    </div>
                </div>
            </div>

            @* Tabla *@
            <div class="table-responsive">
                <QuickGrid Items="listaEventos.AsQueryable()"
                           class="table table-hover text-center mt-3"
                           style="min-width: 950px;">

                    <PropertyColumn Property="e => e.EventoId"
                                    Title="Id" Sortable="true" />

                    <TemplateColumn Title="Fecha de inicio">
                        <div class="text-nowrap">
                            @context.FechaInicio.ToString("dd/MM/yyyy")
                            @context.HoraInicio.ToString("HH:mm")
                        </div>
                    </TemplateColumn>

                    <TemplateColumn Title="Fecha de cierre">
                        <div class="text-nowrap">
                            @context.FechaCierre.ToString("dd/MM/yyyy")
                            @context.HoraCierre.ToString("HH:mm")
                        </div>
                    </TemplateColumn>

                    <PropertyColumn Property="e => e.Nombre"
                                    Title="Nombre" Sortable="true" />

                    <PropertyColumn Property="e => e.Lugar"
                                    Title="Lugar" Sortable="true" />

                    <PropertyColumn Property="e => e.Total"
                                    Title="Total" Sortable="true" />

                    <TemplateColumn Title="Estado">
                        <span class="estado @(context.Estado?.ToLowerInvariant())">
                            @context.Estado
                        </span>
                    </TemplateColumn>

                    <TemplateColumn Title="Opciones">
                        <div class="d-flex flex-nowrap justify-content-center align-items-center gap-1"
                             style="min-width: 100px;">

                            <a href="/eventos/edit/@context.EventoId"
                               class="btn btn-outline-primary bi bi-pencil-square"
                               title="Modificar">
                            </a>

                            <button type="button"
                                    class="btn btn-outline-danger bi bi-x-lg"
                                    title="Eliminar"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalEliminar"
                                    @onclick="() => SeleccionarEvento(context)">
                            </button>

                        </div>
                    </TemplateColumn>

                </QuickGrid>
            </div>
        </div>

        <div class="card-footer d-flex justify-content-between align-items-center mb-4">
            <label>
                <strong>Cantidad: </strong>@listaEventos.Count
            </label>

            <a href="/Eventos/Recuperar"
               class="btn btn-outline-primary bi bi-trash"
               title="Recuperar">
            </a>
        </div>
    </div>
</div>

@* Modal de Eliminación *@
<div class="modal fade"
     id="modalEliminar"
     tabindex="-1"
     aria-labelledby="modalCerrar"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h1 class="modal-title fs-5" id="modalCerrar">
                    Confirmación de eliminación
                </h1>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>
            </div>

            <div class="modal-body">
                <p>
                    ¿Desea eliminar el evento @eventoSeleccionado?.Nombre?
                </p>
            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>

                <button type="button"
                        class="btn btn-danger"
                        data-bs-dismiss="modal"
                        disabled="@procesando"
                        @onclick="Eliminar">
                    Eliminar
                </button>

            </div>

        </div>
    </div>
</div>

@code {
    private List<Evento> listaEventos = new();

    private string FiltroCategoria { get; set; } = string.Empty;
    private string FiltroEstado { get; set; } = string.Empty;
    private string FiltroBusqueda { get; set; } = string.Empty;

    private Evento? eventoSeleccionado;
    private bool procesando = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarEventos();
    }

    private async Task CargarEventos()
    {
        var eventos = await eventoService.GetList(e => e.EventoId > 0) ?? new();

        listaEventos = eventos
            .OrderByDescending(e => e.EventoId)
            .ToList();
    }

    private void SeleccionarEvento(Evento evento)
    {
        eventoSeleccionado = evento;
    }

    private async Task Eliminar()
    {
        if (procesando || eventoSeleccionado == null)
            return;

        procesando = true;

        try
        {
            bool eliminado = await eventoService.Eliminar(eventoSeleccionado.EventoId);

            if (eliminado)
            {
                toastService.ShowSuccess("Evento Eliminado Exitosamente");

                eventoSeleccionado = null;

                await CargarEventos();
            }
            else
            {
                toastService.ShowError("Error al Eliminar el Evento");
            }
        }
        catch (Exception)
        {
            toastService.ShowError("Ocurrió un error al eliminar el evento");
        }
        finally
        {
            procesando = false;
        }
    }
}
