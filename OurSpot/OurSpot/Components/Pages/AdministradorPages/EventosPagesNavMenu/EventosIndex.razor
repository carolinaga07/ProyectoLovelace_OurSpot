@page "/eventos"

@inject EventosService eventoService
@rendermode InteractiveServer

<PageTitle>Eventos</PageTitle>

<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center mb-4">
            <h5 class="card-title align-content-center mt-2">Eventos</h5>
            <a href="/eventos/Crear" class="btn btn-primary" style="background-color:#2D5056"> <span class="bi bi-plus-square-dotted mt-3"></span> Nuevo Evento </a>
        </div>

        <div class="card-body">

            @*labels*@
            <div class="row">

                @*Categoria*@
                <div class="col-3">
                    <label class="col-form-label"><strong>Categor&iacute;a</strong></label>
                </div>

                @*Estado*@
                <div class="col-4">
                    <label class="col-form-label"><strong>Estado</strong></label>
                </div>

                @*Busqueda*@
                <div class="col-5">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>
                </div>
            </div>

            @*Inputs y botones*@
            <div class="row align-items-center mb-3">
                @*Categoria*@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="FiltroCategoria">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="Cultural">Cultural</option>
                        <option value="Social">Social</option>
                        <option value="Empresarial">Empresarial</option>
                        <option value="Deportivo">Deportivo</option>
                    </InputSelect>
                </div>

                @*Estado*@
                <div class="col-4">
                    <InputSelect class="form-select" @bind-Value="FiltroEstado">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="Activo">Activo</option>
                        <option value="Cancelado">Cancelado</option>
                        <option value="Realizado">Realizado</option>
                    </InputSelect>
                </div>

                @*Busqueda*@
                <div class="col-5">
                    <div class="input-group">
                        <input class="form-control" @bind="FiltroBusqueda" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search"></button>
                    </div>
                </div>

            </div>
            <QuickGrid Items="listaEventos.AsQueryable()" class="table table-hover text-center mt-3">
                <PropertyColumn Property="e => e.EventoId" title="EntradaId" Sortable= "true"></PropertyColumn>
                <PropertyColumn Property="e => e.FechaInicio" title="Fecha Inicio" Sortable="true"></PropertyColumn>
                <PropertyColumn Property="e => e.HoraInicio" title="Hora Inicio" Sortable="true"></PropertyColumn>
                <PropertyColumn Property="e => e.FechaCierre" title="Fecha Cierre" Sortable="true"></PropertyColumn>
                <PropertyColumn Property="e => e.HoraCierre" title="Hora Cierre" Sortable="true"></PropertyColumn>
                <PropertyColumn Property="e => e.Nombre" title="Nombre" Sortable="true"></PropertyColumn>
                <PropertyColumn Property="e => e.Lugar" title="Lugar" Sortable="true"></PropertyColumn>
                <PropertyColumn Property="e => e.Descripcion" title="Descripcion" Sortable="true"></PropertyColumn>
                <PropertyColumn Property="e => e.Total" title="Total" Sortable="true"></PropertyColumn>
                <PropertyColumn Property="e => e.Estado" title="Estado" Sortable="true"></PropertyColumn>
                <TemplateColumn title="Opciones">
                    <a href="/eventos/edit/@context.EventoId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                </TemplateColumn>
          </QuickGrid>
        </div>
        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label><strong>Cantidad: </strong>@listaEventos.Count()</label>
            <a href="/Eventos/Recuperar" class="btn btn-outline-primary bi bi-trash" title="Recuperar"></a>
        </div>
    </div>
</div>


@code {
    private List<Evento> listaEventos = new();

    private string FiltroCategoria { get; set; } = string.Empty;
    private string FiltroEstado { get; set; } = string.Empty;
    private string FiltroBusqueda { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        listaEventos = await eventoService.GetList(e => e.EventoId > 0) ?? new();
    }
}