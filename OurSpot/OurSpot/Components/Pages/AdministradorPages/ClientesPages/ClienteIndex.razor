    // Filtros
    private string filtroEstado = "";
    private string busqueda = "";

    private IEnumerable<Cliente> ClientesFiltrados =>
        clientes.Where(c =>
            (string.IsNullOrEmpty(filtroEstado) || c.Estado == filtroEstado)
            &&
            (string.IsNullOrWhiteSpace(busqueda)
                || c.Nombre.Contains(busqueda, StringComparison.OrdinalIgnoreCase)
                || c.Id.ToString().Contains(busqueda.Trim())));

    // Detalle
    private bool mostrarDetalle = false;
    private Cliente? clienteSeleccionado;

    private void VerDetalle(Cliente cliente)
    {
        clienteSeleccionado = cliente;
        mostrarDetalle = true;
    }

    private void CerrarDetalle()
    {
        mostrarDetalle = false;
        clienteSeleccionado = null;
    }

    // Bloquear / Activar
    private bool mostrarCambioEstado = false;
    private Cliente? clienteCambioEstado;
    private string motivoBloqueo = "";

    private void MostrarCambioEstado(Cliente cliente)
    {
        clienteCambioEstado = cliente;
        motivoBloqueo = "";
        mostrarCambioEstado = true;
    }

    private void CerrarCambioEstado()
    {
        mostrarCambioEstado = false;
        clienteCambioEstado = null;
        motivoBloqueo = "";
    }

    private void ConfirmarCambioEstado()
    {
        if (clienteCambioEstado is null)
            return;

        if (clienteCambioEstado.Estado == "Activo")
        {
            if (string.IsNullOrWhiteSpace(motivoBloqueo))
                return;

            clienteCambioEstado.Estado = "Bloqueado";

            clienteCambioEstado.Historial.Add(new Actividad
            {
                Fecha = DateTime.Now,
                Descripcion = $"Cuenta bloqueada. Motivo: {motivoBloqueo.Trim()}"
            });
        }
        else
        {
            clienteCambioEstado.Estado = "Activo";

            clienteCambioEstado.Historial.Add(new Actividad
            {
                Fecha = DateTime.Now,
                Descripcion = "Cuenta activada por el administrador."
            });
        }

        CerrarCambioEstado();
    }

    // Clases temporales para el prototipo
    private class Cliente
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = "";
        public string Correo { get; set; } = "";
        public string Telefono { get; set; } = "";
        public DateTime FechaNacimiento { get; set; }
        public string Direccion { get; set; } = "";
        public DateTime FechaRegistro { get; set; }
        public string Estado { get; set; } = "Activo";
        public List<Reserva> Reservas { get; set; } = new();
        public List<Actividad> Historial { get; set; } = new();
    }

    private class Reserva
    {
        public string Evento { get; set; } = "";
        public DateTime Fecha { get; set; }
        public int Cantidad { get; set; }
        public string Estado { get; set; } = "";
    }

    private class Actividad
    {
        public DateTime Fecha { get; set; }
        public string Descripcion { get; set; } = "";
    }
}
