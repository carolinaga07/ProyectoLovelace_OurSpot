@page "/proveedor/servicios/detalle/{DetalleId:int}"
@layout ProveedorLayout
@attribute [Authorize(Roles = "Proveedor")]
@rendermode InteractiveServer

@inject PortalProveedoresService portalProveedoresService
@inject ToastService toastService
@inject NavigationManager navigationManager

<PageTitle>Detalle del Servicio</PageTitle>

<div class="container mt-4">

    <div class="card shadow-lg">

        <div class="card-header">
            <h4 class="card-title mt-2">
                <a href="/proveedor/home">
                    <i class="bi bi-arrow-left-short fs-1 align-middle"
                       style="color:#2D5056"></i>
                </a>
                Detalle del Servicio
            </h4>
        </div>

        @if (cargando)
        {
            <div class="card-body text-center p-5">
                <div class="spinner-border"></div>
                <p class="mt-3">Cargando servicio...</p>
            </div>
        }
        else if (servicio is null)
        {
            <div class="card-body">
                <div class="alert alert-warning">
                    @mensajeError
                </div>
            </div>
        }
        else
        {
            <div class="card-body">

                <h5 class="mb-3">Información del Evento</h5>

                <div class="row g-3 mb-4">

                    <div class="col-md-6">
                        <label class="form-label fw-bold">
                            Evento
                        </label>
                        <p>@servicio.NombreEvento</p>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">
                            Servicio
                        </label>
                        <p>@servicio.Servicio</p>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">
                            Fecha
                        </label>
                        <p>@servicio.FechaInicio.ToString("dd/MM/yyyy")</p>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">
                            Hora
                        </label>
                        <p>@servicio.HoraInicio.ToString("hh:mm tt")</p>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-bold">
                            Lugar
                        </label>
                        <p>@servicio.Lugar</p>
                    </div>

                </div>

                <hr />

                <h5 class="mb-3">Gestión del Servicio</h5>

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Estado Operativo
                    </label>

                    <InputSelect class="form-select"
                                 @bind-Value="estadoOperativo">
                        <option value="Pendiente">Pendiente</option>
                        <option value="En proceso">En proceso</option>
                        <option value="Completado">Completado</option>
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Observaciones
                    </label>

                    <InputTextArea class="form-control"
                                   rows="4"
                                   @bind-Value="observaciones" />
                </div>

            </div>

            <div class="card-footer text-center">

                <button type="button"
                        class="btn text-white"
                        style="background-color:#2D5056"
                        disabled="@guardando"
                        @onclick="GuardarCambios">

                    @if (guardando)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Guardando...</span>
                    }
                    else
                    {
                        <span class="bi bi-floppy me-2"></span>
                        <span>Guardar Cambios</span>
                    }

                </button>

            </div>
        }

    </div>
</div>

@code {
    [Parameter]
    public int DetalleId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask
    { get; set; }

    private ServicioProveedorDto? servicio;

    private string? usuarioId;
    private string estadoOperativo = "Pendiente";
    private string? observaciones;
    private string mensajeError = "No se encontró el servicio.";

    private bool cargando = true;
    private bool guardando = false;

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        servicio = null;

        try
        {
            if (AuthenticationStateTask is null)
            {
                mensajeError = "No se pudo obtener la sesión.";
                return;
            }

            var authState = await AuthenticationStateTask;

            usuarioId = authState.User.FindFirstValue(
                ClaimTypes.NameIdentifier);

            if (string.IsNullOrEmpty(usuarioId))
            {
                mensajeError = "No se pudo identificar al proveedor.";
                return;
            }

            servicio = await portalProveedoresService
                .ObtenerDetalleServicio(DetalleId, usuarioId);

            if (servicio is null)
            {
                mensajeError =
                    "El servicio no existe o no tienes permiso para consultarlo.";
                return;
            }

            estadoOperativo = servicio.EstadoOperativo;
            observaciones = servicio.ObservacionesProveedor;
        }
        catch (Exception)
        {
            mensajeError = "Ocurrió un error al cargar el servicio.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarCambios()
    {
        if (guardando ||
            servicio is null ||
            string.IsNullOrEmpty(usuarioId))
        {
            return;
        }

        guardando = true;

        try
        {
            bool actualizado = await portalProveedoresService
                .ActualizarEstadoServicio(
                    DetalleId,
                    usuarioId,
                    estadoOperativo,
                    observaciones);

            if (actualizado)
            {
                servicio.EstadoOperativo = estadoOperativo;
                servicio.ObservacionesProveedor = observaciones;

                toastService.ShowSuccess(
                    "Servicio actualizado exitosamente.");
            }
            else
            {
                toastService.ShowError(
                    "No se pudo actualizar el servicio.");
            }
        }
        catch (Exception)
        {
            toastService.ShowError(
                "Ocurrió un error al guardar los cambios.");
        }
        finally
        {
            guardando = false;
        }
    }
}
