@page "/proveedor/perfil"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Proveedor")]
@layout ProveedorLayout
@inject PortalProveedoresService portalProveedoresService

<PageTitle>Mi Perfil - Proveedor</PageTitle>

<div class="container p-4">

    <h2 class="mb-4">Mi Perfil</h2>

    @if (cargando)
    {
        <div class="text-center p-5">
            <div class="spinner-border"></div>
            <p class="mt-3">Cargando perfil...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">
            @error
        </div>
    }
    else if (perfil is not null)
    {
        <div class="card shadow-sm">

            <div class="card-header text-white"
                 style="background:#2D5056">
                <h5 class="mb-0">
                    Información del Proveedor
                </h5>
            </div>

            <div class="card-body">

                @if (!string.IsNullOrEmpty(mensaje))
                {
                    <div class="alert @(guardado ? "alert-success" : "alert-danger")">
                        @mensaje
                    </div>
                }

                <EditForm Model="perfil"
                          OnValidSubmit="GuardarPerfil"
                          FormName="perfilProveedor">

                    <DataAnnotationsValidator />

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">
                                Nombre de la empresa
                            </label>
                            <input class="form-control"
                                   value="@perfil.Nombre"
                                   disabled />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">RNC</label>
                            <input class="form-control"
                                   value="@perfil.Rnc"
                                   disabled />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">
                                Servicio ofrecido
                            </label>
                            <input class="form-control"
                                   value="@perfil.Servicio"
                                   disabled />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Dirección
                            </label>
                            <InputText class="form-control"
                                       @bind-Value="perfil.Direccion" />
                            <ValidationMessage For="() => perfil.Direccion" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Contacto
                            </label>
                            <InputText class="form-control"
                                       @bind-Value="perfil.Contacto" />
                            <ValidationMessage For="() => perfil.Contacto" />
                        </div>

                    </div>

                    <div class="mt-4 text-end">
                        <button type="submit"
                                class="btn text-white"
                                style="background:#2D5056"
                                disabled="@guardando">
                            @(guardando ? "Guardando..." : "Guardar cambios")
                        </button>
                    </div>

                </EditForm>

            </div>
        </div>
    }

</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask
    { get; set; }

    private PerfilProveedorDto? perfil;

    private string? usuarioId;
    private string? error;
    private string? mensaje;

    private bool cargando = true;
    private bool guardando;
    private bool guardado;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (AuthenticationStateTask is null)
            {
                error = "No se pudo obtener la sesión.";
                return;
            }

            var authState = await AuthenticationStateTask;

            usuarioId = authState.User.FindFirstValue(
                ClaimTypes.NameIdentifier);

            if (string.IsNullOrWhiteSpace(usuarioId))
            {
                error = "No se pudo identificar al proveedor.";
                return;
            }

            perfil = await portalProveedoresService
                .ObtenerPerfil(usuarioId);

            if (perfil is null)
                error = "No se encontró el perfil del proveedor.";
        }
        catch (Exception)
        {
            error = "Ocurrió un error al cargar el perfil.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarPerfil()
    {
        if (perfil is null ||
            string.IsNullOrWhiteSpace(usuarioId) ||
            guardando)
            return;

        guardando = true;
        mensaje = null;

        try
        {
            guardado = await portalProveedoresService
                .ActualizarPerfil(usuarioId, perfil);

            mensaje = guardado
                ? "Perfil actualizado correctamente."
                : "No se pudo actualizar el perfil.";
        }
        catch (Exception)
        {
            guardado = false;
            mensaje = "Ocurrió un error al guardar los cambios.";
        }
        finally
        {
            guardando = false;
        }
    }
}
