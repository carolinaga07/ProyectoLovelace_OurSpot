@page "/proveedor/home"
@layout ProveedorLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Proveedor")]

@inject PortalProveedoresService portalProveedoresService

<PageTitle>Inicio - Proveedor</PageTitle>

<div class="container-fluid p-4">

    <h2 class="mb-4">Panel del Proveedor</h2>

    @if (cargando)
    {
        <div class="text-center p-5">
            <div class="spinner-border"></div>
            <p class="mt-3">Cargando servicios...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">
            @error
        </div>
    }
    else
    {
        <!-- Estadísticas -->
        <div class="row g-3 mb-4">

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card text-white p-3 h-100"
                     style="background:#2c4a52">
                    <span>Servicios Asignados</span>
                    <span class="fs-1 fw-bold">
                        @TotalServicios
                    </span>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card text-white p-3 h-100"
                     style="background:#2c4a52">
                    <span>Servicios Pendientes</span>
                    <span class="fs-1 fw-bold">
                        @TotalPendientes
                    </span>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card text-white p-3 h-100"
                     style="background:#2c4a52">
                    <span>En Proceso</span>
                    <span class="fs-1 fw-bold">
                        @TotalEnProceso
                    </span>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card text-white p-3 h-100"
                     style="background:#2c4a52">
                    <span>Completados</span>
                    <span class="fs-1 fw-bold">
                        @TotalCompletados
                    </span>
                </div>
            </div>

        </div>

        
        <!-- Próximos servicios -->
        <div class="card shadow-sm">

            <div class="card-header d-flex justify-content-between
                align-items-center"
                 style="background:#2D5056; color:white;">

                <h5 class="mb-0">Próximos Servicios</h5>

                <a href="/proveedor/servicios"
                   class="btn btn-sm btn-light">
                    Ver todos
                </a>

            </div>

            <div class="card-body">

                @if (ProximosServicios.Count == 0)
                {
                    <div class="alert alert-info mb-0">
                        No tienes próximos servicios pendientes
                        o en proceso.
                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <QuickGrid Items="ProximosServicios.AsQueryable()"
                                   class="table table-hover align-middle">

                            <PropertyColumn Property="s => s.NombreEvento"
                                            Title="Evento" />

                            <PropertyColumn Property="s => s.Servicio"
                                            Title="Servicio" />

                            <PropertyColumn Property="s => s.FechaInicio"
                                            Title="Fecha"
                                            Format="dd/MM/yyyy" />

                            <TemplateColumn Title="Estado">
                                <span class="@ObtenerClaseEstado(context.EstadoOperativo)">
                                    @context.EstadoOperativo
                                </span>
                            </TemplateColumn>

                            <TemplateColumn Title="Acciones">
                                <a href="@($"/proveedor/servicios/detalle/{context.DetalleId}")"
                                   class="btn btn-sm text-white"
                                   style="background:#2D5056">
                                    Ver detalles
                                </a>
                            </TemplateColumn>

                        </QuickGrid>

                    </div>
                }

            </div>

        </div>

       
    }

</div>

@code {

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask
    { get; set; }

    private List<ServicioProveedorDto> servicios = new();
    
    private string busqueda = string.Empty;

    private string filtroEstado = "Todos";

    private bool actualizando = false;

    private string? usuarioId;

    private List<ServicioProveedorDto> ServiciosFiltrados =>
        servicios
            .Where(s =>
                filtroEstado == "Todos" ||
                s.EstadoOperativo == filtroEstado)
            .Where(s =>
                string.IsNullOrWhiteSpace(busqueda) ||
                s.NombreEvento.Contains(
                    busqueda,
                    StringComparison.OrdinalIgnoreCase) ||
                s.Servicio.Contains(
                    busqueda,
                    StringComparison.OrdinalIgnoreCase) ||
                s.Lugar.Contains(
                    busqueda,
                    StringComparison.OrdinalIgnoreCase))
            .OrderBy(s => s.FechaInicio)
            .ThenBy(s => s.HoraInicio)
            .ToList();


    private bool cargando = true;
    private string? error;

    private int TotalServicios =>
        servicios.Count;

    private int TotalPendientes =>
        servicios.Count(s =>
            s.EstadoOperativo == "Pendiente");

    private int TotalEnProceso =>
        servicios.Count(s =>
            s.EstadoOperativo == "En proceso");

    private int TotalCompletados =>
        servicios.Count(s =>
            s.EstadoOperativo == "Completado");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (AuthenticationStateTask is null)
            {
                error = "No se pudo obtener la sesión.";
                return;
            }

            var authState = await AuthenticationStateTask;

            usuarioId = authState.User.FindFirstValue(
             ClaimTypes.NameIdentifier);

            if (string.IsNullOrEmpty(usuarioId))
            {
                error = "No se pudo identificar al proveedor.";
                return;
            }

            servicios = await portalProveedoresService
                .ObtenerServiciosProveedor(usuarioId);
        }
        catch (Exception)
        {
            error = "Ocurrió un error al cargar los servicios.";
        }
        finally
        {
            cargando = false;
        }
    }

    private string ObtenerClaseEstado(string estado)
    {
        return estado switch
        {
            "Pendiente" => "badge bg-warning text-dark",
            "En proceso" => "badge bg-primary",
            "Completado" => "badge bg-success",
            _ => "badge bg-secondary"
        };
    }

    
    private async Task ActualizarServicios()
    {
        if (actualizando || string.IsNullOrWhiteSpace(usuarioId))
            return;

        actualizando = true;
        error = null;

        try
        {
            servicios = await portalProveedoresService
                .ObtenerServiciosProveedor(usuarioId);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Error al actualizar servicios: {ex.Message}");

            error = "No se pudieron actualizar los servicios.";
        }
        finally
        {
            actualizando = false;
        }
    }

    private List<ServicioProveedorDto> ProximosServicios =>
    servicios
        .Where(s =>
            s.FechaInicio >= DateOnly.FromDateTime(DateTime.Today) &&
            (s.EstadoOperativo == "Pendiente" ||
             s.EstadoOperativo == "En proceso"))
        .OrderBy(s => s.FechaInicio)
        .Take(5)
        .ToList();

}
